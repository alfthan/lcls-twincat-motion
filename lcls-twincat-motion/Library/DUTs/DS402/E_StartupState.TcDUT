<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_StartupState" Id="{a438f9d9-85e4-4a52-b694-851762491b8a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_StartupState :
(
    STARTUP_IDLE:=0,        // not running the DS402 boot sequence
    STARTUP_CLEAR,          // clear the controlword
    STARTUP_RESET_FAULT,    // controlword fault reset (bit 7)
    STARTUP_SHUTDOWN,       // controlword shutdown
    STARTUP_SWITCH_ON,      // controlword switch on
    STARTUP_ENABLE_OP,      // controlword enable operation
    STARTUP_WAIT_OPERATIONAL // wait until the drive reports operational
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>