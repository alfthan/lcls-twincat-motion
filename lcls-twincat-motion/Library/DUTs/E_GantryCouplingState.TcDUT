<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_GantryCouplingState" Id="{f34d9184-3fa6-4223-b3a9-276312cef3ae}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
(*
    States of the FB_GantryAutoCoupling master/slave coupling sequence.

    The sequence is non-blocking: each state performs one action per cycle and
    changes on the condition documented in FB_GantryAutoCoupling.
*)
TYPE E_GantryCouplingState :
(
    IDLE       := 0,    // Not coupled and no command in progress
    COUPLING   := 10,   // MC_GearIn running: master and slave being geared together
    COUPLED    := 20,   // Axes geared together, normal operation
    DECOUPLING := 30,   // MC_GearOut running: slave being released from the master
    FAULT      := 99    // Latched fault, cleared only by a rising edge on bReset
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>