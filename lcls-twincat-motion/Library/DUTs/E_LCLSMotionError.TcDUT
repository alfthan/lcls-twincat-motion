<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_LCLSMotionError" Id="{ddea4357-8fae-44da-b5b7-bd2ca001f059}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_LCLSMotionError :
(
    ABORTED := 16#7900,
    UNSAFE := 16#7901,
    INVALID := 16#7902,
    MCS2_FAULT := 16#7903,
    // FB_MicroStepCountTest: a commanded step did not reach MC_MoveRelative.Done inside
    // tStepTimeout
    STEP_TIMEOUT := 16#7906,
    // FB_MicroStepCountTest: nSteps = 0, a step count the loop can never reach
    INVALID_STEP_COUNT := 16#7907,
    TEST := 16#FFFF
) UDINT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>