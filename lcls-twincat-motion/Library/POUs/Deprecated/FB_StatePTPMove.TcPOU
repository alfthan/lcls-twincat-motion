<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StatePTPMove" Id="{425806ee-2b8b-43fd-93f1-34dff217483a}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'obsolete' := 'Use FB_PositionStateMove instead'}
FUNCTION_BLOCK FB_StatePTPMove
// Do not use, this is deprecated
// Requests an absolute move to stPositionState and waits for it to complete.
// The wait is bounded by tTimeout: on expiry the move is aborted the same way as
// a normal abort and bError is raised with sError = 'PTP move timeout' instead of
// waiting forever for a stalled axis, lost drive or failed state transition.
VAR_INPUT
    {attribute 'pytmc' := '
        pv:
    '}
    stPositionState: ST_PositionState;

    {attribute 'pytmc' := '
        pv: GO
        io: io
        field: ZNAM False
        field: ONAM True
    '}
    bExecute: BOOL;

    bMoveOk: BOOL;

    // Maximum time to wait for the commanded move to complete before raising a timeout fault.
    // Must be greater than zero for a useful bound; a zero value faults on the first cycle.
    tTimeout: TIME := T#30S;
END_VAR
VAR_IN_OUT
    stMotionStage: ST_MotionStage;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: AT_STATE
        io: input
        field: ZNAM False
        field: ONAM True
    '}
    bAtState: BOOL;

    {attribute 'pytmc' := '
        pv: DMOV
        io: input
        field: ZNAM False
        field: ONAM True
    '}
    bDone: BOOL;

    {attribute 'pytmc' := '
        pv: BUSY
        io: input
        field: ZNAM False
        field: ONAM True
    '}
    bBusy: BOOL;

    {attribute 'pytmc' := '
        pv: ERR
        io: input
        field: ZNAM False
        field: ONAM True
    '}
    bError: BOOL;

    {attribute 'pytmc' := '
        pv: ERRMSG
        io: input
    '}
    sError: STRING;
END_VAR
VAR
    bExecTrig: R_TRIG;
    bExecEnd: F_TRIG;
    fActPosition: LREAL;
    fLowPos: LREAL;
    fHighPos: LREAL;

    // Bounds the wait for the motion to complete (watchdog for stMotionStage.bBusy)
    tonMoveTimeout: TON;

    // Latched: TRUE after a commanded move timed out without completing. Cleared by a new command.
    bTimedOut: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bExecTrig(CLK:=bExecute);
IF bExecTrig.Q AND bMoveOk THEN
    IF NOT stMotionStage.bBusy AND NOT stMotionStage.bError THEN
        stMotionStage.bExecute := TRUE;
        stMotionStage.nCommand := E_EpicsMotorCmd.MOVE_ABSOLUTE;
        stMotionStage.fPosition := stPositionState.fPosition;
        stMotionStage.fVelocity := stPositionState.fVelocity;
        stMotionStage.fAcceleration := stPositionState.fAccel;
        stMotionStage.fDeceleration := stPositionState.fDecel;
        bDone := FALSE;
        bBusy := TRUE;
        // A new command starts a fresh watchdog and clears the previous timeout fault
        bTimedOut := FALSE;
    END_IF
END_IF

fActPosition := stMotionStage.stAxisStatus.fActPosition;
fLowPos := stPositionState.fPosition - stPositionState.fDelta;
fHighPos := stPositionState.fPosition + stPositionState.fDelta;
IF (fLowPos < fActPosition) AND (fHighPos > fActPosition) THEN
    bAtState := TRUE;
    IF NOT stMotionStage.bBusy THEN
        bDone := TRUE;
        bBusy := FALSE;
        bExecute := FALSE;
    END_IF
ELSE
    bAtState := FALSE;
END_IF

bExecEnd(CLK:=bExecute);
IF bExecEnd.Q AND bBusy THEN
    stMotionStage.bExecute := FALSE;
END_IF

IF NOT stMotionStage.bExecute OR NOT bExecute THEN
    bDone := TRUE;
    bBusy := FALSE;
    bExecute := FALSE;
END_IF

// Bound the wait for the motion to complete: while a move is outstanding, run the watchdog
tonMoveTimeout(IN:=bBusy, PT:=tTimeout);
IF tonMoveTimeout.Q THEN
    // Abort the move through the same path as a normal abort, then latch the fault
    stMotionStage.bExecute := FALSE;
    bDone := TRUE;
    bBusy := FALSE;
    bExecute := FALSE;
    bTimedOut := TRUE;
END_IF

// Surface the axis fault or our own timeout fault, with an explicit message
bError := stMotionStage.bError OR bTimedOut;
IF bTimedOut THEN
    sError := 'PTP move timeout';
ELSE
    sError := stMotionStage.sErrorMessage;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>