<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PositionStateInOut_WithPMPS" Id="{2450f384-9eb5-48af-8d9a-0e0297370332}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'obsolete' := 'Use FB_PositionStatePMPS1D_InOut instead'}
FUNCTION_BLOCK FB_PositionStateInOut_WithPMPS EXTENDS FB_PositionStateBase_WithPMPS
(*
    Purpose
        Example usage of FB_PositionStateBase_WithPMPS for a simple IN/OUT axis, and a drop-in
        for these cases (no need to roll your own in/out).
        This is the PMPS version. Note that the only difference is that we extend the _WithPMPS FB.
        Deprecated: use FB_PositionStatePMPS1D_InOut instead.

    Usage
        Instantiate in place of FB_PositionStatePMPS1D_InOut in legacy projects.
        Wire enumSet (command) and enumGet (readback), copying their pytmc pragmas exactly.
        Do not pragma stIn/stOut; the manager handles those. See the NOTE: comments below.

    Objectives
        - Keep older projects compiling while they migrate to FB_PositionStatePMPS1D_InOut.
        - Show the minimal configuration of an IN/OUT axis on the PMPS state base block.

    History
        2020-07-10  Zachary Lentz    Created during the position-state rework.
        2022-01-12  K Lauer          Set stIn/stOut names for in/out state positioners.
        2023-03-15  Zachary Lentz    Marked deprecated; kept for backwards compatibility.
        2026-11-28  AI agent (#432)  Added purpose, usage, objectives and history header.
*)
VAR_INPUT
    // The enum position to move to
    {attribute 'pytmc' := '
        pv: SET
        io: io
    '}
    enumSet: ENUM_EpicsInOut_INT; // NOTE: Please copy this pragma exactly on your enumSet

    // Information about the OUT position
    stOut: ST_PositionState; // NOTE: Do not pragma these, let it happen in the manager.
    // Information about the IN position
    stIn: ST_PositionState;
END_VAR
VAR_OUTPUT
    // The enum state readback
    {attribute 'pytmc' := '
        pv: GET
        io: i
    '}
    enumGet: ENUM_EpicsInOut_INT; // NOTE: Please copy this pragma exactly on your enumGet
END_VAR
VAR
    bInOutInit: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bInOutInit THEN
    bInOutInit := TRUE;
    arrStates[1] := stOut;
    arrStates[2] := stIn;
    stOut.sName := 'OUT';
    stIn.sName := 'IN';
END_IF
setState := enumSet;
Exec();
enumGet := getState;
enumSet := setState;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>