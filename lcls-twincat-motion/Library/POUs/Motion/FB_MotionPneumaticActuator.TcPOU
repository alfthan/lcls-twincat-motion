<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionPneumaticActuator" Id="{3965ca68-046c-4858-93f1-aaf5b6059f9e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Pneumatic Actuator
    Implements a pneumatic actuator. It can be single or double acting by setting
    the iq_stPneumaticActuator.bSingleCntrl flag accordingly.
    With a double acting actuator bCntrlHold should be FALSE; with a single acting
    actuator it should be TRUE.

    Interface: the complete command and status data of this actuator - limit switch
    readbacks, digital output states, insert/retract permits, arbiter permit, the
    EPICS commands, the hardware configuration flags, the fast-fault reset flags and
    the resulting status - lives in the single VAR_IN_OUT interface struct
    ST_MotionPneumaticActuator, so a caller binds one reference and owns the state.
    The only other reference is the PMPS fast-fault output chain, which is wiring,
    not device command/status data.

    History:
        2026-11-27  scirix agent  Moved the interface struct from VAR_OUTPUT to
                                  VAR_IN_OUT and folded the separate BOOL command,
                                  interlock and status terminals into it (audit
                                  finding 351, convention conv_83a907114111).
*)
FUNCTION_BLOCK FB_MotionPneumaticActuator
VAR_IN_OUT
    (* The complete command and status interface of this actuator *)
    {attribute 'pytmc' := '
    pv:
    '}
    iq_stPneumaticActuator    :    ST_MotionPneumaticActuator;
    (* PMPS fast-fault output chain this actuator contributes to *)
    io_fbFFHWO    :    FB_HardwareFFOutput;
END_VAR
VAR
    // PMPS
    fbFF    :    FB_FastFault :=(
        i_DevName := 'MPA',
        i_Desc := 'Fault occurs when the device is moving',
        i_TypeCode := E_MotionFFType.PNEUMATIC_MOVE);

    (*Init*)
    xFirstPass    :    BOOL;
    fbFSInit        :    R_TRIG;

    (* Timeouts*)
    tTimeOutDuration: TIME:= T#10S;
    tInserttimeout: TON;
    tRetracttimeout:TON;
    (*Limit switch latch timer*)
    tLimitSwitchLatchDuration: TIME:=T#1S;
    tInsertLimitSwitch:TON;
    tRetractLimitSwitch:TON;

    (*Logging*)
    fbLogger : FB_LogMessage := (eSubsystem:=E_SubSystem.MOTION);
    ePrevState : E_PnuematicActuatorPositionState;
    tAction : R_TRIG; // Primary action of this device (Insert_DO, Retract_DO, etc.)
    tOverrideActivated : R_TRIG;

    (*IO*)
    i_xInsertedLS    AT%I*: BOOL;
    i_xRetractedLS    AT%I*: BOOL;
    q_xInsert_DO    AT%Q*: BOOL;
    q_xRetract_DO    AT%Q*: BOOL;

END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[// An unbound interface struct cannot be dereferenced: fault out quietly.
IF NOT __ISVALIDREF(iq_stPneumaticActuator) THEN
    RETURN;
END_IF

(*Initialize*)
fbFSInit( CLK := TRUE, Q => xFirstPass);
IF xFirstPass THEN
    iq_stPneumaticActuator.eState := E_PnuematicActuatorPositionState.INVALID;
    iq_stPneumaticActuator.bRetract_SW := FALSE;
    iq_stPneumaticActuator.bInsert_SW := FALSE;
END_IF

(*Soft IO Mapping to EPICS PVs*)
ACT_IO();

(* Manage States*)
IF iq_stPneumaticActuator.i_bInLimitSwitch AND  iq_stPneumaticActuator.i_bOutLimitSwitch THEN
    iq_stPneumaticActuator.eState:=E_PnuematicActuatorPositionState.INVALID;
ELSIF NOT iq_stPneumaticActuator.i_bInLimitSwitch AND iq_stPneumaticActuator.i_bOutLimitSwitch THEN
    iq_stPneumaticActuator.eState:=E_PnuematicActuatorPositionState.RETRACTED;
ELSIF iq_stPneumaticActuator.i_bInLimitSwitch AND NOT iq_stPneumaticActuator.i_bOutLimitSwitch THEN
    iq_stPneumaticActuator.eState:=E_PnuematicActuatorPositionState.INSERTED;
ELSIF NOT iq_stPneumaticActuator.i_bInLimitSwitch AND NOT iq_stPneumaticActuator.i_bOutLimitSwitch THEN
    iq_stPneumaticActuator.eState:=E_PnuematicActuatorPositionState.MOVING;
ELSE
    iq_stPneumaticActuator.eState:=E_PnuematicActuatorPositionState.INVALID ;
END_IF

(*Set the Done/Busy signal*)
iq_stPneumaticActuator.bDone := (iq_stPneumaticActuator.bRetract_SW AND iq_stPneumaticActuator.eState=E_PnuematicActuatorPositionState.RETRACTED)
                            OR (iq_stPneumaticActuator.bInsert_SW AND iq_stPneumaticActuator.eState=E_PnuematicActuatorPositionState.INSERTED);
iq_stPneumaticActuator.bBusy := (iq_stPneumaticActuator.bRetract_SW AND iq_stPneumaticActuator.eState<>E_PnuematicActuatorPositionState.RETRACTED)
                            OR (iq_stPneumaticActuator.bInsert_SW AND iq_stPneumaticActuator.eState<>E_PnuematicActuatorPositionState.INSERTED);
(*MPS FAULT*)
(* MPS Faults when the actuator is in motion*)
iq_stPneumaticActuator.bMPS_OK := (iq_stPneumaticActuator.eState=E_PnuematicActuatorPositionState.RETRACTED) OR (iq_stPneumaticActuator.eState=E_PnuematicActuatorPositionState.INSERTED);
(*PMPS PERMISSION*)
// yet to be implemented

(* Can't have bRetract_SW and  bInsert_SW both be true*)
If (iq_stPneumaticActuator.bRetract_SW) AND (iq_stPneumaticActuator.bInsert_SW) THEN
    iq_stPneumaticActuator.bRetract_SW := FALSE;
    iq_stPneumaticActuator.bInsert_SW := FALSE;
END_IF
//Redundant??
(*Check if both digital outputs active at the same time, and clear all*)
IF iq_stPneumaticActuator.q_bInsert THEN
    iq_stPneumaticActuator.q_bRetract := FALSE;
    iq_stPneumaticActuator.bRetract_SW:= FALSE;
END_IF;
IF iq_stPneumaticActuator.q_bRetract THEN
    iq_stPneumaticActuator.q_bInsert := FALSE;
    iq_stPneumaticActuator.bInsert_SW:= FALSE;
END_IF;

(*Actuate the device*)
iq_stPneumaticActuator.q_bRetract := iq_stPneumaticActuator.bRetractOK AND iq_stPneumaticActuator.bRetract_SW AND NOT iq_stPneumaticActuator.bInsert_SW ;
iq_stPneumaticActuator.q_bInsert := iq_stPneumaticActuator.bInsertOK AND iq_stPneumaticActuator.bInsert_SW AND NOT iq_stPneumaticActuator.bRetract_SW ;

(*Reset the Control signal when command has been executed and give time to ensure the actuator is fully seated in either direction*)
IF (NOT iq_stPneumaticActuator.bSingleCntrl AND NOT iq_stPneumaticActuator.bCntrlHold) THEN
   IF (iq_stPneumaticActuator.bRetract_SW AND iq_stPneumaticActuator.i_bOutLimitSwitch AND tRetractLimitSwitch.Q ) THEN iq_stPneumaticActuator.q_bRetract := FALSE; END_IF
   IF (iq_stPneumaticActuator.bInsert_SW AND iq_stPneumaticActuator.i_bInLimitSwitch AND tInsertLimitSwitch.Q) THEN iq_stPneumaticActuator.q_bInsert := FALSE; END_IF
END_IF

(*Timers*)
tInserttimeout(IN:= iq_stPneumaticActuator.q_bInsert, PT := tTimeOutDuration );
tRetracttimeout(IN:= iq_stPneumaticActuator.q_bRetract, PT := tTimeOutDuration);
tInsertLimitSwitch(IN:= iq_stPneumaticActuator.i_bInLimitSwitch, PT := tLimitSwitchLatchDuration);
tRetractLimitSwitch(IN:= iq_stPneumaticActuator.i_bOutLimitSwitch, PT := tLimitSwitchLatchDuration);


///Check moving postion timout
IF NOT iq_stPneumaticActuator.i_bInLimitSwitch AND tInserttimeout.Q THEN
    iq_stPneumaticActuator.bError := TRUE;
    iq_stPneumaticActuator.sErrorMessage:= 'Actuator insert timeout';
ELSIF NOT iq_stPneumaticActuator.i_bOutLimitSwitch AND tRetracttimeout.Q THEN
    iq_stPneumaticActuator.bError := TRUE;
    iq_stPneumaticActuator.sErrorMessage:= 'Actuator retract timeout';
END_IF
// Reset error
iq_stPneumaticActuator.bError R= iq_stPneumaticActuator.bReset;

(*FAST FAULT*)
fbFF(i_xOK := iq_stPneumaticActuator.bMPS_OK,
    i_xReset := iq_stPneumaticActuator.bFFReset,
    i_xAutoReset := iq_stPneumaticActuator.bFFAutoReset,
    io_fbFFHWO := io_fbFFHWO);

(*Soft IO Mapping to Epics pvs*)
ACT_IO();]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{090f58e5-b160-4478-a84f-328a90ba6204}">
      <Implementation>
        <ST><![CDATA[(*Inputs*)
iq_stPneumaticActuator.i_bInLimitSwitch :=  i_xInsertedLS;
iq_stPneumaticActuator.i_bOutLimitSwitch := i_xRetractedLS;

(*outputs*)
q_xInsert_DO:=iq_stPneumaticActuator.q_bInsert;
q_xRetract_DO:=iq_stPneumaticActuator.q_bRetract;]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_Logger" Id="{9640fc94-0c07-4d2d-854f-09768bff8197}">
      <Implementation>
        <ST><![CDATA[// Log Valve timeouts
IF (tInserttimeout.Q OR tRetracttimeout.Q) THEN fbLogger(sMsg:=iq_stPneumaticActuator.sErrorMessage, eSevr:=TcEventSeverity.Warning); END_IF

// Log Actuator commands
// Log valve open
tAction(CLK:= (iq_stPneumaticActuator.q_bRetract OR iq_stPneumaticActuator.q_bInsert));
IF tAction.Q THEN
   IF(iq_stPneumaticActuator.q_bRetract) THEN fbLogger(sMsg:='Actuator commanded retract', eSevr:=TcEventSeverity.Info); END_IF
   IF(iq_stPneumaticActuator.q_bInsert) THEN fbLogger(sMsg:='Actuator commanded insert', eSevr:=TcEventSeverity.Info); END_IF
END_IF


// State Logging
IF ePrevState <> iq_stPneumaticActuator.eState THEN
      CASE iq_stPneumaticActuator.eState OF
        E_PnuematicActuatorPositionState.INVALID:
            fbLogger(sMsg:='Actuator invalid position.', eSevr:=TcEventSeverity.Critical);
          E_PnuematicActuatorPositionState.MOVING:
            fbLogger(sMsg:='Actuator moving', eSevr:=TcEventSeverity.Warning);
        E_PnuematicActuatorPositionState.RETRACTED:
            fbLogger(sMsg:='Actuator Retracted.', eSevr:=TcEventSeverity.Info);
        E_PnuematicActuatorPositionState.INSERTED:
            fbLogger(sMsg:='Actuator Inserted.', eSevr:=TcEventSeverity.Info);
      END_CASE
      ePrevState := iq_stPneumaticActuator.eState;
  END_IF
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>