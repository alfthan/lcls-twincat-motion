<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StatesInputHandler" Id="{048f7518-d863-40bd-9997-a5f33bbe686c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StatesInputHandler
(*
    Handle the state enum EPICS input for any of the ND state function blocks.

    The desired behavior is:
    - Trigger a move to a new state when the enum PV is written to
    - Interrupt an ongoing move with a new one if the enum changes mid-move
    - Reject an invalid enum write instead of acting on it

    The set value (stUserInput.nSetValue) is a raw EPICS enum write, so it is sanitized
    before it is latched:
    - 0 means "no request".
    - A request is only valid in 1..GeneralConstants.MAX_STATES.
    - An out-of-range write is rejected: it is never latched into nQueuedGoal or bNewMove,
      so it cannot start a bad move and it cannot abort an ongoing move.
    - While the input is invalid, the last trusted pending request is held unchanged.
    - bSetValueValid reports the validity of the value seen this cycle and bSetValueRejected
      latches the rejection until the next valid write or a RESET. The rejection is published
      to EPICS as STATE:SETINVALID and logged once per event.

    History:
    - 2026-11-28, Scirix Agent: sanitize the EPICS set value and expose its validity (audit finding #1113).
*)
VAR_IN_OUT
    // The user's inputs from EPICS. This is an IN_OUT variable because we will write values back to this to help us detect when the same value is re-caput
    stUserInput: ST_StateEpicsToPlc;
END_VAR
VAR_INPUT
    // The bBusy boolean from the motion FB
    bMoveBusy: BOOL;
    // The starting state number to seed nCurrGoal with
    nStartingState: UINT;
    // TRUE if we have a move error, to prevent moves
    bMoveError: BOOL;
END_VAR
VAR_OUTPUT
    // The goal index to input to the motion FB. This will be clamped to the range 0..GeneralConstants.MAX_STATES
    nCurrGoal: UINT;
    // The bExecute boolean to input to the motion FB
    bExecMove: BOOL;
    // The bReset boolean to input to the motion FB
    bResetMove: BOOL;

    // TRUE if the set value seen this cycle was usable (no request, or an in-range request). FALSE if the write was out of range and was rejected.
    bSetValueValid: BOOL;

    // Latched TRUE when an out-of-range set value was rejected. Clears on the next valid request or on a RESET, and is published to EPICS as STATE:SETINVALID.
    bSetValueRejected: BOOL;
END_VAR
VAR
    nState: UINT;
    bInit: BOOL;
    nQueuedGoal: UINT;
    bNewMove: BOOL;
    nCachedStart: UINT;
    rtRejected: R_TRIG;
    fbLog: FB_LogMessage := (eSubsystem := E_Subsystem.MOTION);
END_VAR
VAR CONSTANT
    IDLE: UINT := 0;
    GOING: UINT := 1;
    WAIT_STOP: UINT := 2;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
bResetMove := stUserInput.bReset;
IF bResetMove OR NOT bInit THEN
    bInit := TRUE;
    stUserInput.nSetValue := 0;
    nCurrGoal := nStartingState;
    nCachedStart := nStartingState;
    bExecMove := FALSE;
    nState := IDLE;
    bNewMove := FALSE;
    // A reset also clears any latched rejection of a bad set value
    bSetValueValid := TRUE;
    bSetValueRejected := FALSE;
END_IF

// Sanitize the raw EPICS enum write before it can latch a move request.
// 0 means "no request", and a request is only valid in 1..GeneralConstants.MAX_STATES.
// An out-of-range write must never reach nQueuedGoal or bNewMove: latching it would request a
// bogus goal while idle and would abort an ongoing move while moving.
bSetValueValid := stUserInput.nSetValue = 0 OR stUserInput.nSetValue <= GeneralConstants.MAX_STATES;
IF stUserInput.nSetValue <> 0 THEN
    IF bSetValueValid THEN
        // Trusted request: latch it, replacing any previous pending request
        nQueuedGoal := stUserInput.nSetValue;
        bNewMove := TRUE;
        bSetValueRejected := FALSE;
    ELSE
        // Rejected request: hold the last trusted goal and do not ask for a move
        bSetValueRejected := TRUE;
    END_IF
END_IF

CASE nState OF
    IDLE:
        IF bNewMove AND nQueuedGoal > 0 AND nQueuedGoal <= GeneralConstants.MAX_STATES THEN
            // New request, currently idle -> ask for a move
            nCurrGoal := nQueuedGoal;
            bExecMove := TRUE;
            bNewMove := FALSE;
        ELSIF bMoveBusy THEN
            // We're moving but used to be idle -> switch to GOING
            nState := GOING;
        ELSIF nStartingState <> nCachedStart THEN
            // Usually a late position init, sometimes a live change in encoder offset
            // The state changed without a move, so we need to partially reinitialize.
            nCurrGoal := nStartingState;
        END_IF
    GOING:
        IF bNewMove THEN
            // New request, currently moving -> ask for a stop
            nState := WAIT_STOP;
            bExecMove := FALSE;
        ELSIF NOT bMoveBusy THEN
            nState := IDLE;
            nQueuedGoal := 0;
            bExecMove := FALSE;
        END_IF
    WAIT_STOP:
        IF NOT bMoveBusy THEN
            nState := IDLE;
        END_IF
END_CASE

IF bMoveError THEN
    bExecMove := FALSE;
END_IF

// Report each rejected EPICS write once. The flag stays latched until a valid write or a reset.
rtRejected(CLK := bSetValueRejected);
IF rtRejected.Q THEN
    fbLog(
        sMsg := CONCAT(
            'Rejected an out of range state set request from EPICS. The maximum state index is ',
            UINT_TO_STRING(GeneralConstants.MAX_STATES)
        ),
        eSevr := TcEventSeverity.Warning,
    );
END_IF

// Detect if the set/start position updates without a move
nCachedStart := nStartingState;

// Help us detect if there is an EPICS put before the next cycle
stUserInput.nSetValue := 0;
stUserInput.bReset := FALSE;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>