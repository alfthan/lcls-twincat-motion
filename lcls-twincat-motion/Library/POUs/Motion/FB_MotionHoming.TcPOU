<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionHoming" Id="{89795143-e01c-4e96-8d50-67b6176895fe}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionHoming
(*
    FB_MotionHoming

    Purpose:
        Reference (home) the single NC axis owned by an ST_MotionStage, following the
        home command the motor record requests in stMotionStage.nHomingMode. The axis is
        jogged at the search velocity (stMotionStage.stAxisParameters.fRefVeloSearch)
        until the requested limit or home sensor is reached, jogged slowly off that
        switch at the sync velocity (fRefVeloSync) so the switch is always approached
        from the same side, and MC_SetPosition makes stMotionStage.fHomePosition the new
        reference position.

    Usage:
        Call once per cycle from FB_MotionStage, with the stage being homed:
            fbMotionHome(stMotionStage:=stMotionStage, bExecute:=bExecHome);
        bExecute is the motor record execute command: the block does nothing while it is
        FALSE and a sequence only starts on its rising edge. Supported nHomingMode
        values are LOW_LIMIT, HIGH_LIMIT, HOME_VIA_LOW and HOME_VIA_HIGH (up to two
        search moves, one per direction, first in the direction implied by the mode),
        ABSOLUTE_SET (apply fHomePosition to an absolute encoder, no movement) and NONE
        (no homing configured). The axis must be enabled, and the sequence uses
        stMotionStage.Axis status directly (limits, home sensor, standstill).

    Objectives:
        - Home without trusting the soft limits of the pre-homing position: each search
          move first sets the position to FWD_START/BWD_START, far outside any real
          travel range, so the limit that is being searched for can never block the
          move and a stuck start position is obvious instead of a silent limit failure.
        - Never search forever: at most two search moves (one per direction) and three
          consecutive MC_Jog errors, then give up with a latched fault.
        - Stay non-blocking: one action per state, and WAIT_STOP waits for the axis to
          report standstill before the next action begins.
        - Report everything to the caller: bBusy while the sequence runs, bDone when it
          ends, and bError/nErrorID plus stMotionStage.sCustomErrorMessage on failure.
        - Never hide an abort: dropping bExecute while the axis is still moving ends the
          sequence with bError and the message "Homing interrupted".

    Units:
        Positions and velocities are in the engineering units (EGU) of the NC axis
        scaling: stMotionStage.fHomePosition, FWD_START and BWD_START are EGU,
        fRefVeloSearch and fRefVeloSync are EGU/s.

    History:
        2020-11-05  Zachary Lentz   First working homing sequence, wired into the
                                    FB_MotionStage IOC control loop.
        2021-01-06  Zachary Lentz   Added the standstill waits to the homing routines.
        2026-11-28  taio-generic-0  Documented the POU header and every declaration
                                    (audit finding #336); no functional change.
*)
VAR_IN_OUT
    // The motion stage being homed. Reads Axis, nHomingMode, fHomePosition (EGU),
    // stAxisParameters.fRefVeloSearch and fRefVeloSync (EGU/s), bHome and the limit
    // enables; writes sCustomErrorMessage when the sequence faults.
    stMotionStage: ST_MotionStage;
END_VAR
VAR_INPUT
    // Execute the homing sequence. Rising edge starts it and it must stay TRUE until
    // the sequence ends; the falling edge aborts a running sequence ("Homing
    // interrupted") and also re-arms bError, so a fault is only held while bExecute
    // is TRUE.
    bExecute: BOOL;
END_VAR
VAR_OUTPUT
    // TRUE while a homing sequence is running; FALSE in IDLE and once it has ended.
    // In the ABSOLUTE_SET and NONE modes it is TRUE for the single scan that follows
    // the rising edge of bExecute.
    bBusy: BOOL;
    // TRUE once the sequence has ended; in the ABSOLUTE_SET and NONE modes it is
    // simply the inverse of bBusy. Check bError to tell success from failure, because
    // the fault path also ends a sequence.
    bDone: BOOL;
    // Latched fault: no reference found, axis error while searching, or sequence
    // interrupted by dropping bExecute. Held until bExecute is dropped.
    bError: BOOL;
    // Error ID of the failing MC_Jog block; 0 while bError is FALSE and also 0 when
    // the sequence gave up without an axis error (see sCustomErrorMessage).
    nErrorID: UDINT;
END_VAR
VAR
    // Sets the axis position: to fHomePosition for the final reference, or to
    // FWD_START/BWD_START to take the axis out of the old soft limits while searching.
    fbSetPos: MC_SetPosition;
    // Continuous jog that performs the search moves and the slow move off the switch,
    // at fRefVeloSearch and fRefVeloSync respectively.
    fbJog: MC_Jog;
    // Rising edge of bExecute: starts the sequence, and flashes bBusy/bDone in the
    // ABSOLUTE_SET and NONE modes.
    rtExec: R_TRIG;
    // Falling edge of bExecute: turns a sequence that is still moving into an
    // interrupted-sequence fault.
    ftExec: F_TRIG;
    // Current state of the homing state machine (IDLE .. WAIT_STOP).
    nHomeStateMachine: INT := IDLE;
    // State WAIT_STOP goes to once the axis reports standstill.
    nStateAfterStop: INT;
    // Number of search moves started: move 0 and move 1 pick opposite directions and a
    // move beyond that is treated as "reference not found".
    nMoves: INT;
    // TRUE when the first search move goes in the positive direction (HIGH_LIMIT,
    // HOME_VIA_HIGH); the second search then goes the other way.
    bFirstDirection: BOOL;
    // TRUE when the requested home sensor or limit is already active at the start, so
    // the search moves are skipped and FINAL_MOVE runs directly.
    bAtHome: BOOL;
    // TRUE while the selected nHomingMode needs motion (the limit and home sensor
    // searches); FALSE for ABSOLUTE_SET and NONE.
    bMove: BOOL;
    // Consecutive MC_Jog errors in the current search state; the third one faults.
    nErrCount: INT;
    // TRUE when the fault was caused by bExecute dropping while the axis was still
    // moving, which selects the "Homing interrupted" message over "Homing failure".
    bInterrupted: BOOL;
END_VAR
VAR CONSTANT
    // State machine: wait for the rising edge of bExecute before doing anything.
    IDLE: INT := 0;
    // State machine: pick the direction of the next search move.
    NEXT_MOVE: INT := 1;
    // State machine: search forward at fRefVeloSearch for the home sensor or the
    // forward limit.
    CHECK_FWD: INT := 2;
    // State machine: search backward at fRefVeloSearch for the home sensor or the
    // backward limit.
    CHECK_BWD: INT := 3;
    // State machine: set the position to fHomePosition and jog slowly off the switch
    // at fRefVeloSync.
    FINAL_MOVE: INT := 4;
    // State machine: set the position to fHomePosition for good and finish.
    FINAL_SETPOS: INT := 5;
    // State machine: latch bError/nErrorID and publish the custom error message.
    ERROR: INT := 6;
    // State machine: wait for the axis to stand still, then go to nStateAfterStop.
    WAIT_STOP: INT := 7;

    (*
        This is a simpler way of disabling the soft limits that ends up being really obvious if something has gone wrong.
        If you turn the limits off/on, not only do you need to keep track of if you had soft limits set,
        but you need to always restore this properly or risk some issue.
        Instead, I set position to a ridiculous value that can always move forward or backward.
        If this gets stuck for any reason it's very clear that something has gone wrong,
        rather than a silent failure of the soft limit marks.
    *)
    // Position (EGU) forced onto the axis before a forward search, so that moving
    // forward is always allowed; deliberately outside any real travel range.
    FWD_START: LREAL := -99999999;
    // Position (EGU) forced onto the axis before a backward search, so that moving
    // backward is always allowed; deliberately outside any real travel range.
    BWD_START: LREAL :=  99999999;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
fbSetPos.Options.ClearPositionLag := TRUE;
rtExec(CLK:=bExecute);
ftExec(CLK:=bExecute);

bError R= NOT bExecute;
IF NOT bError THEN
    nErrorID := 0;
END_IF

CASE stMotionStage.nHomingMode OF
    E_EpicsHomeCmd.LOW_LIMIT:
        bFirstDirection := FALSE;
        bAtHome := NOT stMotionStage.bLimitBackwardEnable;
        bMove := TRUE;
    E_EpicsHomeCmd.HIGH_LIMIT:
        bFirstDirection := TRUE;
        bAtHome := NOT stMotionStage.bLimitForwardEnable;
        bMove := TRUE;
    E_EpicsHomeCmd.HOME_VIA_LOW:
        bFirstDirection := FALSE;
        bAtHome := stMotionStage.bHome;
        bMove := TRUE;
    E_EpicsHomeCmd.HOME_VIA_HIGH:
        bFirstDirection := TRUE;
        bAtHome := stMotionStage.bHome;
        bMove := TRUE;
    E_EpicsHomeCmd.ABSOLUTE_SET:
        fbSetPos(
            Axis:=stMotionStage.Axis,
            Execute:=bExecute,
            Position:=stMotionStage.fHomePosition);
        bBusy := rtExec.Q;
        bDone := NOT rtExec.Q;
        bMove := FALSE;
    E_EpicsHomeCmd.NONE:
        bMove := FALSE;
        bBusy := rtExec.Q;
        bDone := NOT rtExec.Q;
    ELSE
        bMove := FALSE;
END_CASE

IF bMove THEN
    IF bBusy AND ftExec.Q THEN
        nHomeStateMachine := ERROR;
        bInterrupted := TRUE;
    END_IF
    CASE nHomeStateMachine OF
        // Wait for a rising edge
        IDLE:
            bBusy := FALSE;
            nErrCount := 0;
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=FALSE);
            fbJog(
                Axis:=stMotionStage.Axis,
                JogForward:=FALSE,
                JogBackwards:=FALSE);
            IF rtExec.Q THEN
                nHomeStateMachine := NEXT_MOVE;
                nMoves := 0;
                bDone := FALSE;
                bBusy := TRUE;
                bError := FALSE;
                nErrorID := 0;
                bInterrupted := FALSE;
            END_IF
        // Figure out whether to move forward, move backward, or give up
        NEXT_MOVE:
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=FALSE);
            fbJog(
                Axis:=stMotionStage.Axis,
                JogForward:=FALSE,
                JogBackwards:=FALSE);
            CASE nMoves OF
                0:
                    IF bFirstDirection THEN
                        nStateAfterStop := CHECK_FWD;
                    ELSE
                        nStateAfterStop := CHECK_BWD;
                    END_IF
                1:
                    IF NOT bFirstDirection THEN
                        nStateAfterStop := CHECK_FWD;
                    ELSE
                        nStateAfterStop := CHECK_BWD;
                    END_IF
                ELSE
                    nStateAfterStop := ERROR;
            END_CASE
            nMoves := nMoves + 1;
            IF bAtHome THEN
                nStateAfterStop := FINAL_MOVE;
            END_IF
            nHomeStateMachine := WAIT_STOP;
        // Move forward until we find the home signal or reach end of travel
        CHECK_FWD:
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=TRUE,
                Position:=FWD_START);
            fbJog(
                Axis:=stMotionStage.Axis,
                JogForward:=stMotionStage.bLimitForwardEnable AND NOT bATHome,
                JogBackwards:=FALSE,
                Mode:=E_JogMode.MC_JOGMODE_CONTINOUS,
                Velocity:=stMotionStage.stAxisParameters.fRefVeloSearch);
            IF NOT fbJog.JogForward THEN
                nHomeStateMachine := NEXT_MOVE;
            ELSIF fbJog.Error THEN
                fbJog(
                    Axis:=stMotionStage.Axis,
                    JogForward:=FALSE,
                    JogBackwards:=FALSE);
                nErrCount := nErrCount + 1;
                IF nErrCount >= 3 THEN
                    nHomeStateMachine := ERROR;
                END_IF
            END_IF
        // Move backward until we find the home signal or reach end of travel
        CHECK_BWD:
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=TRUE,
                Position:=BWD_START);
            fbJog(
                Axis:=stMotionStage.Axis,
                JogForward:=FALSE,
                JogBackwards:=stMotionStage.bLimitBackwardEnable AND NOT bATHome,
                Mode:=E_JogMode.MC_JOGMODE_CONTINOUS,
                Velocity:=stMotionStage.stAxisParameters.fRefVeloSearch);
            IF NOT fbJog.JogBackwards THEN
                nHomeStateMachine := NEXT_MOVE;
            ELSIF fbJog.Error THEN
                fbJog(
                    Axis:=stMotionStage.Axis,
                    JogForward:=FALSE,
                    JogBackwards:=FALSE);
                nErrCount := nErrCount + 1;
                IF nErrCount >= 3 THEN
                    nHomeStateMachine := ERROR;
                END_IF
            END_IF
        // Set position to get within soft lims, move slowly off signal
        FINAL_MOVE:
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=TRUE,
                Position:=stMotionStage.fHomePosition);
            IF bAtHome THEN
                fbJog(
                    Axis:=stMotionStage.Axis,
                    JogForward:=NOT bFirstDirection,
                    JogBackwards:=bFirstDirection,
                    Mode:=E_JogMode.MC_JOGMODE_CONTINOUS,
                    Velocity:=stMotionStage.stAxisParameters.fRefVeloSync);
            ELSIF fbJog.Error THEN
                fbJog(
                    Axis:=stMotionStage.Axis,
                    JogForward:=FALSE,
                    JogBackwards:=FALSE);
                nErrCount := nErrCount + 1;
                IF nErrCount >= 3 THEN
                    nHomeStateMachine := ERROR;
                END_IF
            ELSE
                fbJog(
                    Axis:=stMotionStage.Axis,
                    JogForward:=FALSE,
                    JogBackwards:=FALSE);
                fbSetPos(
                    Axis:=stMotionStage.Axis,
                    Execute:=FALSE);
                nHomeStateMachine := WAIT_STOP;
                nStateAfterStop := FINAL_SETPOS;
            END_IF
        FINAL_SETPOS:
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=TRUE,
                Position:=stMotionStage.fHomePosition);
            nHomeStateMachine := IDLE;
            bBusy := FALSE;
            bDone := TRUE;
        ERROR:
            bError := TRUE;
            nErrorID := fbJog.ErrorID;
            nHomeStateMachine := FINAL_SETPOS;
            fbSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=FALSE);
            IF bInterrupted THEN
                stMotionStage.sCustomErrorMessage := 'Homing interrupted';
            ELSE
                stMotionStage.sCustomErrorMessage := 'Homing failure';
            END_IF
        WAIT_STOP:
            IF stMotionStage.Axis.Status.NotMoving THEN
                nHomeStateMachine := nStateAfterStop;
            END_IF
    END_CASE
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>