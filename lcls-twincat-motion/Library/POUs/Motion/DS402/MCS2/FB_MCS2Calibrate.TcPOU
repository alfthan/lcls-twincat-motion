<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MCS2Calibrate" Id="{4b86a6e1-43f7-489f-9e64-44b7835fe9ac}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MCS2Calibrate
VAR_INPUT
    bExecute : BOOL;
END_VAR
VAR_IN_OUT
    stDS402Drive         : ST_DS402Drive;
    stMotionStage        : ST_MotionStage;
END_VAR

VAR_OUTPUT
    bCalibrateMoveBusy        : BOOL;
    bCalibrateMoveDone        : BOOL;
    bCalibrateMoveAborted     : BOOL;
END_VAR
VAR
    eStepState	: E_MoveState := E_MoveState.IDLING;
    {attribute 'hide'}
    bReset :  BOOL;
    {attribute 'hide'}
    bHalt : BOOL;
    // TRUE for the first cycle only: de-energises the drive command bits
    // before any move can be commanded (see the start-up block below).
    bFirstScan           : BOOL := TRUE;
    {attribute 'hide'}
    tonSettlingTime     : TON;
    {attribute 'hide'}
    rtCalibrateMove: R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(stDS402Drive)
    OR NOT __ISVALIDREF(stMotionStage) THEN
   RETURN;
END_IF

(*
    Drive command bits (DS402 control word):
        bit 3 = enable operation, bit 4 = op-mode specific (calibration) start.
    Both are driven FALSE on the first scan and in every state that does not
    actively command the move, so a fault, an abort or an idle cycle can never
    leave the drive enabled or a command latched on.
*)
IF bFirstScan THEN
    bFirstScan := FALSE;
    stDS402Drive.nDriveControl.3 := FALSE;
    stDS402Drive.nDriveControl.4 := FALSE;
END_IF

rtCalibrateMove(CLK := bExecute);

CASE eStepState OF

    E_MoveState.IDLING:
        // Idle: this block commands nothing, so the op-mode specific start bit
        // is held cleared. Bit 3 (enable operation) is cleared on every entry
        // into IDLING (DONE/INTERRUPTED/ERROR) and is deliberately
        // left alone here: between moves the drive manager's DS402 start-up
        // sequence owns the control word and re-enables the drive for the next
        // move, so holding it low would defeat that handshake.
        stDS402Drive.nDriveControl.4 := FALSE;
        IF rtCalibrateMove.Q THEN
            bCalibrateMoveBusy := TRUE;
            bCalibrateMoveDone := FALSE;
            // Set bits 0-3 for calibration enable
            stDS402Drive.nDriveControl.3 := TRUE;
            eStepState := E_MoveState.INIT;
        END_IF

    E_MoveState.INIT:
        // Always run the routine, even when the drive reports Calibration Attained
        // (Bit12): a Safe-Direction change invalidates the stored calibration while
        // leaving Bit12 set, so re-calibration must not be skipped.
        IF stMotionStage.bError THEN
            eStepState := E_MoveState.ERROR;
        ELSE
            stDS402Drive.nDriveControl.4 := TRUE;
            tonSettlingTime.IN:=TRUE;
            eStepState := E_MoveState.IN_PROGRESS;
        END_IF

    E_MoveState.IN_PROGRESS:
        IF bHalt OR bReset THEN
            bCalibrateMoveAborted := TRUE;
            // Abort: de-energise in this cycle, not only on the next scan.
            stDS402Drive.nDriveControl.3 := FALSE;
            stDS402Drive.nDriveControl.4 := FALSE;
            eStepState := E_MoveState.INTERRUPTED;
        ELSIF stDS402Drive.stDriveStatus.Bit13_OpModeSpecific THEN
            stMotionStage.bError := TRUE;
            // Fault: de-energise in this cycle, not only on the next scan.
            stDS402Drive.nDriveControl.3 := FALSE;
            stDS402Drive.nDriveControl.4 := FALSE;
            eStepState := E_MoveState.ERROR;
        ELSE
            IF tonSettlingTime.Q AND stDS402Drive.stDriveStatus.TargetReached
              AND stDS402Drive.stDriveStatus.Bit12_OpModeSpecific THEN
                eStepState := E_MoveState.REACHED;
            END_IF
        END_IF

    E_MoveState.INTERRUPTED:
        // Aborted: no drive command bit may stay asserted.
        stDS402Drive.nDriveControl.3 := FALSE;
        stDS402Drive.nDriveControl.4 := FALSE;
        bCalibrateMoveBusy := FALSE;
        eStepState := E_MoveState.IDLING;

    E_MoveState.REACHED:
        bCalibrateMoveBusy := FALSE;
        bCalibrateMoveDone := TRUE;
        // Target reached: calibration is no longer commanded, drop the start
        // bit; bit 3 is dropped on the way back to IDLING.
        stDS402Drive.nDriveControl.4 := FALSE;
        eStepState := E_MoveState.DONE;
    E_MoveState.DONE:
        IF stMotionStage.bDone THEN
            // Calibration acknowledged: leave no command bit asserted and the
            // drive de-energised until the next move enables it again.
            stDS402Drive.nDriveControl.3 := FALSE;
            stDS402Drive.nDriveControl.4 := FALSE;
            eStepState := E_MoveState.IDLING;
        END_IF
    E_MoveState.ERROR:
        // Faulted: hold the drive de-energised for as long as the fault lasts.
        stDS402Drive.nDriveControl.3 := FALSE;
        stDS402Drive.nDriveControl.4 := FALSE;
        bCalibrateMoveBusy := FALSE;
        IF NOT stMotionStage.bError THEN
            eStepState := E_MoveState.IDLING;
        END_IF

END_CASE

tonSettlingTime(PT:=T#80MS);
bHalt := FALSE;
bReset := FALSE;]]></ST>
    </Implementation>
    <Method Name="Halt" Id="{054cef2f-a2aa-4334-b8f8-3db255f14cab}">
      <Declaration><![CDATA[METHOD Halt : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.bHalt := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{9e18e8d8-fd2f-4f8f-8fc9-d6ef7ef731d6}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.bReset := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>