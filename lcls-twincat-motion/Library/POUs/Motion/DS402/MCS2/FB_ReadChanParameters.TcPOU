<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ReadChanParameters" Id="{08ee74cb-7e7d-468d-8ff5-637be4dc44de}" SpecialFunc="None">
    <Declaration><![CDATA[// ============================================================================
// FB_ReadChanParameters
// ----------------------------------------------------------------------------
// Purpose:
//   Two-queue serialized SDO reader for MCS2 channel parameters.
//
// Usage:
//   Call once per PLC cycle, after stMotionStage, stMCS2ChanParameter and
//   stDS402Drive are wired. All three are VAR_IN_OUT references and are
//   validated with __ISVALIDREF on entry; on an invalid reference the block
//   returns without touching anything. Drive bEnable TRUE to let the queues
//   run; bEnable FALSE parks every bExecute line and resets the queue timers
//   without clearing the last read-back values. The first read is gated by
//   stMotionStage.bAxisParamsInit. This block owns every read of the channel
//   object, so no write request may be in flight at the same time.
//
// Queues:
//   Two independent state machines, both serializing onto the same slave but
//   gated against each other so only one SDO request is outstanding at a time.
//
//     FAST queue: ChannelState only. Polled continuously at nReadTime. This is
//       the latency-sensitive path that interlocks depend on.
//
//     SLOW queue: the remaining 21 parameters (positioner type, calibration
//       options, sensor power mode, referencing options, reference type, safe
//       direction, motor load, channel type, max closed-loop frequency,
//       logical scale offset, logical scale inversion, channel temperature,
//       movement type, base unit, base resolution, distance code inverted,
//       positioner control options, actuator mode, motor load protection
//       threshold, diagnostic closed-loop frequency max and avg), plus the two
//       soft-limit entries -- NUM_SLOW entries in total. Polled once at boot,
//       then every tSlowReadInterval (default 30 s). One read at a time. A
//       failed read is counted and the queue advances to the next entry.
//
//   Both queues yield to each other: the fast queue will not start a new
//   ChannelState read while the slow queue has one in flight, and vice versa.
//   Because ChannelState reads are short (sub-100 ms) and the slow refresh
//   cadence is tens of seconds, ChannelState almost always wins the bus.
//
//   EVENT queue: one-shot read of the drive error code (0x603F) after a fault
//   or internal-limit event. Highest priority, still mutually exclusive with
//   the other two queues.
//
// Objectives:
//   - Keep ChannelState fresh enough for interlock decisions while refreshing
//     the rarely changing configuration parameters in the background.
//   - Never leave more than one CoE mailbox request outstanding on the slave.
//   - Bound every read with a watchdog, so a lost mailbox reply cannot stall a
//     queue, and keep the resulting failures as diagnostics rather than
//     user-facing faults.
//
// Author:
//   Yann Stephen Mandza <ysmandza@slac.stanford.edu>
//   Created 2025-10-28.
//
// History:
//   2025-10-28  Yann Stephen Mandza  Created in the DS402/MCS2 homing and
//                                    channel-state refactor.
//   2026-05-19  ysmandza             Split into fast/slow queues with per-read
//                                    watchdogs to avoid slave CoE mailbox races.
//   2026-08-07  ysmandza             Eight channel parameters plus the diag
//                                    closed-loop frequency pair and safe
//                                    direction added to the read traffic.
//   2026-08-17  ysmandza             Event queue added to preserve channel
//                                    fault diagnostics.
//   2026-08-25  Mandza               Transient ChannelState read failures are
//                                    counted, not surfaced as faults.
//   2026-08-29  Mandza               REF_OPT/CAL_OPT stay io:io commands; only
//                                    their per-bit decode is read-only.
//   2026-11-28  Documentation pass   POU and method headers plus inline
//                                    declaration comments added; no logic
//                                    change.
// ============================================================================

FUNCTION_BLOCK FB_ReadChanParameters
VAR_INPUT
    // TRUE lets the read queues run. FALSE parks every bExecute line and
    // resets the queue timers without clearing the last read-back values.
    // Safe-state default: the caller must set it TRUE explicitly.
    bEnable : BOOL;
END_VAR

VAR_IN_OUT
    // Stage being watched. Supplies the AMS NetId of the EtherCAT master for
    // the mailbox calls and the bAxisParamsInit gate that starts the first
    // sweep. Read-only for this block.
    stMotionStage       : ST_MotionStage;
    // Channel-parameter image this block owns. Supplies the per-parameter
    // object indices it reads and receives the read-back values (all NUM_SLOW
    // slow entries plus the ChannelState word and the drive error code).
    stMCS2ChanParameter : ST_MCS2ChanParameter;
    // DS402 drive state. Supplies the slave address of the MCS2 mailbox and
    // the InternalLimitActive flag that arms the event queue. Read-only for
    // this block.
    stDS402Drive        : ST_DS402Drive;
END_VAR

VAR_OUTPUT
    // TRUE once every entry in the slow queue has completed (succeeded or
    // failed) at least once. Diagnostic only -- not used to gate anything.
    bAllReadsComplete : BOOL;
    // Count of slow-queue entries that errored on their most recent attempt.
    // Cleared at the start of each slow sweep. Diagnostic only.
    nSlowReadFailures : UINT;
    // Count of fast-queue (ChannelState) reads that errored or timed out.
    // Diagnostic only -- not surfaced as a user-facing error, since polling
    // retries every cadence and a lone miss is not a fault.
    nFastReadFailures : UINT;
END_VAR

VAR

    // SDO reader instances

    // Fast queue
    fbChannelStateRead       : FB_EcCoESdoRead;
    // Event queue
    fbDriveErrCodeRead       : FB_EcCoESdoRead;
    // Slow queue: one reader per slow-queue entry, ordered exactly like the
    // index tables in StartSlowRead / SlowReadEdge / SlowReadError.
    fbMaxCloseLoopFreqRead   : FB_EcCoESdoRead; // Max closed-loop frequency
    fbSoftLimMinRead         : FB_EcCoESdoRead; // Soft limit, negative end
    fbSoftLimMaxRead         : FB_EcCoESdoRead; // Soft limit, positive end
    fbPositionerTypeRead     : FB_EcCoESdoRead; // Positioner type
    fbCalibrationOptRead     : FB_EcCoESdoRead; // Calibration options word
    fbSensorPowerModeRead    : FB_EcCoESdoRead; // Sensor power mode
    fbReferencingOptRead     : FB_EcCoESdoRead; // Referencing options word
    fbReferenceTypeRead      : FB_EcCoESdoRead; // Reference type
    fbSafeDirRead            : FB_EcCoESdoRead; // Safe direction
    fbMotorLoadRead          : FB_EcCoESdoRead; // Motor load (% of rated load)
    fbChannelTypeRead        : FB_EcCoESdoRead; // Channel type
    fbLogicalScaleOffsetRead : FB_EcCoESdoRead; // Logical scale offset
    fbLogicalScaleInvRead    : FB_EcCoESdoRead; // Logical scale inversion
    fbChannelTempRead        : FB_EcCoESdoRead; // Channel temperature (deg C)
    fbMovementTypeRead       : FB_EcCoESdoRead; // Movement type
    fbBaseUnitRead           : FB_EcCoESdoRead; // Base unit
    fbBaseResolutionRead     : FB_EcCoESdoRead; // Base resolution
    fbDistCodeInvRead        : FB_EcCoESdoRead; // Distance code inverted
    fbPositionerCtrlOptRead  : FB_EcCoESdoRead; // Positioner control options
    fbActuatorModeRead       : FB_EcCoESdoRead; // Actuator mode
    fbMotorLoadProtRead      : FB_EcCoESdoRead; // Motor load protection threshold
    // Diag closed-loop frequency is a subindexed object (0x202A:1 = max,
    // 0x202A:2 = avg); one reader per subindex.
    fbDiagClfMaxRead         : FB_EcCoESdoRead;
    fbDiagClfAvgRead         : FB_EcCoESdoRead;


    // Completion edge detectors

    ftChannelStateRead       : F_TRIG;
    ftDriveErrCodeRead       : F_TRIG;
    ftMaxCloseLoopFreqRead   : F_TRIG;
    ftSoftLimMinRead         : F_TRIG;
    ftSoftLimMaxRead         : F_TRIG;
    ftPositionerTypeRead     : F_TRIG;
    ftCalibrationOptRead     : F_TRIG;
    ftSensorPowerModeRead    : F_TRIG;
    ftReferencingOptRead     : F_TRIG;
    ftReferenceTypeRead      : F_TRIG;
    ftSafeDirRead            : F_TRIG;
    ftMotorLoadRead          : F_TRIG;
    ftChannelTypeRead        : F_TRIG;
    ftLogicalScaleOffsetRead : F_TRIG;
    ftLogicalScaleInvRead    : F_TRIG;
    ftChannelTempRead        : F_TRIG;
    ftMovementTypeRead       : F_TRIG;
    ftBaseUnitRead           : F_TRIG;
    ftBaseResolutionRead     : F_TRIG;
    ftDistCodeInvRead        : F_TRIG;
    ftPositionerCtrlOptRead  : F_TRIG;
    ftActuatorModeRead       : F_TRIG;
    ftMotorLoadProtRead      : F_TRIG;
    ftDiagClfMaxRead         : F_TRIG;
    ftDiagClfAvgRead         : F_TRIG;


    // Per-reader execute lines (driven by queue FSMs)

    bExecChannelState       : BOOL;
    bExecDriveErrCode       : BOOL;
    bExecMaxCloseLoopFreq   : BOOL;
    bExecSoftLimMin         : BOOL;
    bExecSoftLimMax         : BOOL;
    bExecPositionerType     : BOOL;
    bExecCalibrationOpt     : BOOL;
    bExecSensorPowerMode    : BOOL;
    bExecReferencingOpt     : BOOL;
    bExecReferenceType      : BOOL;
    bExecSafeDir            : BOOL;
    bExecMotorLoad          : BOOL;
    bExecChannelType        : BOOL;
    bExecLogicalScaleOffset : BOOL;
    bExecLogicalScaleInv    : BOOL;
    bExecChannelTemp        : BOOL;
    bExecMovementType       : BOOL;
    bExecBaseUnit           : BOOL;
    bExecBaseResolution     : BOOL;
    bExecDistCodeInv        : BOOL;
    bExecPositionerCtrlOpt  : BOOL;
    bExecActuatorMode       : BOOL;
    bExecMotorLoadProt      : BOOL;
    bExecDiagClfMax         : BOOL;
    bExecDiagClfAvg         : BOOL;


    // Fast queue (ChannelState)

    // Fast-queue state machine states.
    eFast : (
        // Parked: bExecute forced FALSE; next cycle re-enters the cadence wait.
        FAST_IDLE          := 0,
        // Waiting for the nReadTime cadence to elapse. Power-on state.
        FAST_WAIT_CADENCE  := 1,
        // ChannelState read in flight; watchdog armed.
        FAST_READING       := 2
    ) := FAST_WAIT_CADENCE;
    // nReadTime cadence timer for the fast queue.
    tonFastCadence : TON;
    // Set on a fault or limit event: the drive error code reports the failed move,
    // not its cause, so the channel state bits must not be up to nReadTime stale.
    bFastReadNow : BOOL;
    // Per-read watchdog for ChannelState.
    tonFastReadTimeout : TON;
    // Watchdog limit for one ChannelState read (default 2 s).
    tFastReadTimeout : TIME := T#2S;


    // Event queue (drive error code)

    // 0x603F holds the last channel error and is refreshed by the drive when the
    // Internal Limit flag is set, so it explains limit stops the NC cannot.
    // Event-queue state machine states.
    eEvt : (
        // No event read requested or in flight.
        EVT_IDLE    := 0,
        // Drive error code (0x603F) read in flight; watchdog armed.
        EVT_READING := 1
    ) := EVT_IDLE;
    // Rising edge on bError or InternalLimitActive: arms a drive-error read.
    rtErrEvent : R_TRIG;
    // A drive-error read has been requested and not yet started.
    bEvtReadPending : BOOL;
    // Event-queue read in flight; blocks the fast and slow queues.
    bEvtReadActive : BOOL;
    // Read watchdog for the event queue.
    tonEvtReadTimeout : TON;
    // Watchdog limit for one drive-error read (default 2 s).
    tEvtReadTimeout : TIME := T#2S;


    // Slow queue (everything else)

    // Slow-queue state machine states.
    eSlow : (
        // Parked: waits for bAxisParamsInit, then restarts at index 1.
        SLOW_IDLE       := 0,
        // Waiting out tSlowReadInterval between two sweeps.
        SLOW_WAIT_CADENCE := 1,
        // Sweeping the table, one read at a time.
        SLOW_RUNNING    := 2
    ) := SLOW_IDLE;
    // Index into the slow-queue table. 1..NUM_SLOW; 0 = sweep complete.
    nSlowIdx : INT;
    // TRUE while a slow read is in flight (kick issued, edge not yet seen).
    bSlowReadActive : BOOL;
    // tSlowReadInterval cadence timer between two sweeps.
    tonSlowCadence : TON;
    // Per-read watchdog: if a slow read doesn't complete in tSlowReadTimeout
    // we count it as a failure, force-clear bExecute, and advance.
    tonSlowReadTimeout : TON;
    // TRUE once the boot sweep has run to completion. Diagnostic only.
    bFirstSlowSweepDone : BOOL;

    // Configurable cadences / timeouts for the slow queue.
    // Interval between the start of two consecutive sweeps (default 30 s).
    tSlowReadInterval : TIME := T#30S;
    // Watchdog limit for one slow read (default 2 s).
    tSlowReadTimeout  : TIME := T#2S;
END_VAR
VAR CONSTANT
    // Number of entries in the slow-queue table: the 21 channel parameters
    // plus the two soft limits. Indices in the CASE tables run 1..NUM_SLOW.
    NUM_SLOW : INT := 23;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(stDS402Drive)
    OR NOT __ISVALIDREF(stMotionStage)
    OR NOT __ISVALIDREF(stMCS2ChanParameter) THEN
    RETURN;
END_IF

IF NOT bEnable THEN
    // Park everything off.
    bExecChannelState       := FALSE;
    bExecMaxCloseLoopFreq   := FALSE;
    bExecPositionerType     := FALSE;
    bExecCalibrationOpt     := FALSE;
    bExecSensorPowerMode    := FALSE;
    bExecReferencingOpt     := FALSE;
    bExecReferenceType      := FALSE;
    bExecSafeDir            := FALSE;
    bExecMotorLoad          := FALSE;
    bExecChannelType        := FALSE;
    bExecLogicalScaleOffset := FALSE;
    bExecLogicalScaleInv    := FALSE;
    bExecChannelTemp        := FALSE;
    bExecMovementType       := FALSE;
    bExecBaseUnit           := FALSE;
    bExecBaseResolution     := FALSE;
    bExecDistCodeInv        := FALSE;
    bExecPositionerCtrlOpt  := FALSE;
    bExecActuatorMode       := FALSE;
    bExecMotorLoadProt      := FALSE;
    bExecDiagClfMax         := FALSE;
    bExecDiagClfAvg         := FALSE;
    bExecDriveErrCode       := FALSE;
    bEvtReadPending         := FALSE;
    bEvtReadActive          := FALSE;
    bFastReadNow            := FALSE;
    eEvt                    := EVT_IDLE;
    tonEvtReadTimeout(IN := FALSE);
    tonFastCadence(IN := FALSE);
    tonSlowCadence(IN := FALSE);
    CallAllSdoReaders();
    RETURN;
END_IF

// Tick all the F_TRIGs from the previous cycle's bBusy snapshots.
ftChannelStateRead       (CLK := fbChannelStateRead.bBusy);
ftDriveErrCodeRead       (CLK := fbDriveErrCodeRead.bBusy);
ftMaxCloseLoopFreqRead   (CLK := fbMaxCloseLoopFreqRead.bBusy);
    ftSoftLimMinRead         (CLK := fbSoftLimMinRead.bBusy);
    ftSoftLimMaxRead         (CLK := fbSoftLimMaxRead.bBusy);
ftPositionerTypeRead     (CLK := fbPositionerTypeRead.bBusy);
ftCalibrationOptRead     (CLK := fbCalibrationOptRead.bBusy);
ftSensorPowerModeRead    (CLK := fbSensorPowerModeRead.bBusy);
ftReferencingOptRead     (CLK := fbReferencingOptRead.bBusy);
ftReferenceTypeRead      (CLK := fbReferenceTypeRead.bBusy);
ftSafeDirRead            (CLK := fbSafeDirRead.bBusy);
ftMotorLoadRead          (CLK := fbMotorLoadRead.bBusy);
ftChannelTypeRead        (CLK := fbChannelTypeRead.bBusy);
ftLogicalScaleOffsetRead (CLK := fbLogicalScaleOffsetRead.bBusy);
ftLogicalScaleInvRead    (CLK := fbLogicalScaleInvRead.bBusy);
ftChannelTempRead        (CLK := fbChannelTempRead.bBusy);
ftMovementTypeRead       (CLK := fbMovementTypeRead.bBusy);
ftBaseUnitRead           (CLK := fbBaseUnitRead.bBusy);
ftBaseResolutionRead     (CLK := fbBaseResolutionRead.bBusy);
ftDistCodeInvRead        (CLK := fbDistCodeInvRead.bBusy);
ftPositionerCtrlOptRead  (CLK := fbPositionerCtrlOptRead.bBusy);
ftActuatorModeRead       (CLK := fbActuatorModeRead.bBusy);
ftMotorLoadProtRead      (CLK := fbMotorLoadProtRead.bBusy);
ftDiagClfMaxRead         (CLK := fbDiagClfMaxRead.bBusy);
ftDiagClfAvgRead         (CLK := fbDiagClfAvgRead.bBusy);

// Run the two queues. Each yields to the other -- only one outstanding SDO
// at a time across the whole FB.
rtErrEvent(CLK := stMotionStage.bError OR stDS402Drive.stDriveStatus.InternalLimitActive);
IF rtErrEvent.Q THEN
    bEvtReadPending := TRUE;
    bFastReadNow    := TRUE;
END_IF

EventQueueStep();
FastQueueStep();
SlowQueueStep();

// Cyclically call every reader. bExecute lines are owned by the queues.
CallAllSdoReaders();

// Decode the raw option words into individual read-only flags.
DecodeOptions();
]]></ST>
    </Implementation>
    <Method Name="CallAllSdoReaders" Id="{0a000001-0000-0000-0000-000000000009}">
      <Declaration><![CDATA[// ============================================================================
// CallAllSdoReaders  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Cyclically call every SDO reader FB so each one advances its
//           internal state machine and refreshes bBusy/bError.
// Usage   : Called once per cycle from the body, and also on the
//           bEnable = FALSE and invalid-reference park paths so no reader is
//           left un-ticked. bExecute is never driven here -- the fast, slow
//           and event queue methods own those lines.
// Inputs  : none
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE CallAllSdoReaders
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Fast
fbChannelStateRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanStateIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.stChannelState.nChannelStateRaw),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.stChannelState.nChannelStateRaw),
    bExecute   := bExecChannelState
);

// Event
fbDriveErrCodeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanErrorCodeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nMCS2ErrorCode),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nMCS2ErrorCode),
    bExecute   := bExecDriveErrCode
);

// Slow
fbMaxCloseLoopFreqRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanMaxCloseLoopFreqIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nMaxCloseLoopFreq),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nMaxCloseLoopFreq),
    bExecute   := bExecMaxCloseLoopFreq
);
fbSoftLimMinRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanSoftLimitIdx,
    nSubIndex  := 1,
    pDstBuf    := ADR(stMCS2ChanParameter.nSoftLimMin),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nSoftLimMin),
    bExecute   := bExecSoftLimMin
);
fbSoftLimMaxRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanSoftLimitIdx,
    nSubIndex  := 2,
    pDstBuf    := ADR(stMCS2ChanParameter.nSoftLimMax),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nSoftLimMax),
    bExecute   := bExecSoftLimMax
);
fbPositionerTypeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanPositionerTypeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nPositionerType),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nPositionerType),
    bExecute   := bExecPositionerType
);
fbCalibrationOptRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanCalibrationOptIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nCalibrationOpt),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nCalibrationOpt),
    bExecute   := bExecCalibrationOpt
);
fbSensorPowerModeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanSensorPowerModeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nSensorPowerMode),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nSensorPowerMode),
    bExecute   := bExecSensorPowerMode
);
fbReferencingOptRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanReferencingOptIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nReferencingOpt),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nReferencingOpt),
    bExecute   := bExecReferencingOpt
);
fbReferenceTypeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanReferenceTypeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nReferenceType),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nReferenceType),
    bExecute   := bExecReferenceType
);
fbSafeDirRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanSafeDirIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nSafeDir),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nSafeDir),
    bExecute   := bExecSafeDir
);
fbMotorLoadRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanMotorLoadIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nMotorLoad),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nMotorLoad),
    bExecute   := bExecMotorLoad
);
fbChannelTypeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChannelTypeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nChannelType),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nChannelType),
    bExecute   := bExecChannelType
);
fbLogicalScaleOffsetRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanLogicalScaleOfsIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nLogicalScaleOffset),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nLogicalScaleOffset),
    bExecute   := bExecLogicalScaleOffset
);
fbLogicalScaleInvRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanLogicalScaleInvIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nLogicalScaleInv),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nLogicalScaleInv),
    bExecute   := bExecLogicalScaleInv
);
fbChannelTempRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanChannelTempIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nChannelTemp),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nChannelTemp),
    bExecute   := bExecChannelTemp
);
fbMovementTypeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanMovementTypeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nMovementType),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nMovementType),
    bExecute   := bExecMovementType
);
fbBaseUnitRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanBaseUnitIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nBaseUnit),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nBaseUnit),
    bExecute   := bExecBaseUnit
);
fbBaseResolutionRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanBaseResolutionIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nBaseResolution),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nBaseResolution),
    bExecute   := bExecBaseResolution
);
fbDistCodeInvRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanDistCodeInvIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nDistCodeInv),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nDistCodeInv),
    bExecute   := bExecDistCodeInv
);
fbPositionerCtrlOptRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanPositionerCtrlOptIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nPositionerCtrlOpt),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nPositionerCtrlOpt),
    bExecute   := bExecPositionerCtrlOpt
);
fbActuatorModeRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanActuatorModeIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nActuatorMode),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nActuatorMode),
    bExecute   := bExecActuatorMode
);
fbMotorLoadProtRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanMotorLoadProtIdx,
    nSubIndex  := 0,
    pDstBuf    := ADR(stMCS2ChanParameter.nMotorLoadProt),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nMotorLoadProt),
    bExecute   := bExecMotorLoadProt
);
fbDiagClfMaxRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanDiagClfIdx,
    nSubIndex  := 1,
    pDstBuf    := ADR(stMCS2ChanParameter.nDiagClfMax),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nDiagClfMax),
    bExecute   := bExecDiagClfMax
);
fbDiagClfAvgRead(
    sNetId     := stMotionStage.stAxisParameters.sAmsNetId,
    nSlaveAddr := stDS402Drive.nSlaveAddr,
    nIndex     := stMCS2ChanParameter.nChanDiagClfIdx,
    nSubIndex  := 2,
    pDstBuf    := ADR(stMCS2ChanParameter.nDiagClfAvg),
    cbBufLen   := SIZEOF(stMCS2ChanParameter.nDiagClfAvg),
    bExecute   := bExecDiagClfAvg
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearAllSlowExecutes" Id="{0a000001-0000-0000-0000-000000000005}">
      <Declaration><![CDATA[// ============================================================================
// ClearAllSlowExecutes  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Drop every slow-queue bExecute line in a single pass.
// Usage   : Called on entry to SLOW_IDLE and SLOW_WAIT_CADENCE -- i.e. after a
//           sweep completes, before a new sweep starts, and every cycle while
//           the queue is parked -- so no stale request stays asserted.
// Inputs  : none
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE ClearAllSlowExecutes
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bExecMaxCloseLoopFreq   := FALSE;
bExecPositionerType     := FALSE;
bExecCalibrationOpt     := FALSE;
bExecSensorPowerMode    := FALSE;
bExecReferencingOpt     := FALSE;
bExecReferenceType      := FALSE;
bExecSafeDir            := FALSE;
bExecMotorLoad          := FALSE;
bExecChannelType        := FALSE;
bExecLogicalScaleOffset := FALSE;
bExecLogicalScaleInv    := FALSE;
bExecChannelTemp        := FALSE;
bExecMovementType       := FALSE;
bExecBaseUnit           := FALSE;
bExecBaseResolution     := FALSE;
bExecDistCodeInv        := FALSE;
bExecPositionerCtrlOpt  := FALSE;
bExecActuatorMode       := FALSE;
bExecMotorLoadProt      := FALSE;
bExecDiagClfMax         := FALSE;
bExecDiagClfAvg         := FALSE;
bExecSoftLimMin         := FALSE;
bExecSoftLimMax         := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearSlowExecute" Id="{0a000001-0000-0000-0000-000000000004}">
      <Declaration><![CDATA[// ============================================================================
// ClearSlowExecute  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Drop the bExecute line of one slow-queue entry.
// Usage   : Called after the read at index <idx> completes or times out. The
//           index must match the one passed to StartSlowRead, i.e. the
//           1-based position in the slow-queue table.
// Inputs  : idx -- slow-queue table index, 1..NUM_SLOW (dimensionless).
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE ClearSlowExecute
VAR_INPUT
    // Slow-queue table index, 1..NUM_SLOW. Values outside that range match no
    // CASE label and are ignored.
    idx : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE idx OF
    1:  bExecMaxCloseLoopFreq   := FALSE;
    2:  bExecPositionerType     := FALSE;
    3:  bExecCalibrationOpt     := FALSE;
    4:  bExecSensorPowerMode    := FALSE;
    5:  bExecReferencingOpt     := FALSE;
    6:  bExecReferenceType      := FALSE;
    7:  bExecSafeDir            := FALSE;
    8:  bExecMotorLoad          := FALSE;
    9:  bExecChannelType        := FALSE;
    10: bExecLogicalScaleOffset := FALSE;
    11: bExecLogicalScaleInv    := FALSE;
    12: bExecChannelTemp        := FALSE;
    13: bExecMovementType       := FALSE;
    14: bExecBaseUnit           := FALSE;
    15: bExecBaseResolution     := FALSE;
    16: bExecDistCodeInv        := FALSE;
    17: bExecPositionerCtrlOpt  := FALSE;
    18: bExecActuatorMode       := FALSE;
    19: bExecMotorLoadProt      := FALSE;
    20: bExecDiagClfMax         := FALSE;
    21: bExecDiagClfAvg         := FALSE;
    22: bExecSoftLimMin         := FALSE;
    23: bExecSoftLimMax         := FALSE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DecodeChannelState" Id="{0a000001-0000-0000-0000-000000000008}">
      <Declaration><![CDATA[// ============================================================================
// DecodeChannelState  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Unpack the 32-bit raw ChannelState word into the individual flag
//           fields of stMCS2ChanParameter.stChannelState, and leave an inferred
//           MCS2 error code behind as a fallback diagnostic.
// Usage   : Called from FastQueueStep only after a successful read, so the
//           flags always match the latest raw word. The inferred code is
//           overwritten by the 0x603F read when the event queue obtains it.
// Inputs  : none (operates on the stMCS2ChanParameter reference)
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE DecodeChannelState
VAR
    // Raw 32-bit ChannelState word being unpacked.
    n : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := stMCS2ChanParameter.stChannelState.nChannelStateRaw;
stMCS2ChanParameter.stChannelState.bActivelyMoving        := (n AND 16#00000001) <> 0;
stMCS2ChanParameter.stChannelState.bClosedLoopActive      := (n AND 16#00000002) <> 0;
stMCS2ChanParameter.stChannelState.bCalibrating           := (n AND 16#00000004) <> 0;
stMCS2ChanParameter.stChannelState.bReferencing           := (n AND 16#00000008) <> 0;
stMCS2ChanParameter.stChannelState.bMoveDelayed           := (n AND 16#00000010) <> 0;
stMCS2ChanParameter.stChannelState.bSensorPresent         := (n AND 16#00000020) <> 0;
stMCS2ChanParameter.stChannelState.bIsCalibrated          := (n AND 16#00000040) <> 0;
stMCS2ChanParameter.stChannelState.bIsReferenced          := (n AND 16#00000080) <> 0;
stMCS2ChanParameter.stChannelState.bEndStopReached        := (n AND 16#00000100) <> 0;
stMCS2ChanParameter.stChannelState.bRangeLimitReached     := (n AND 16#00000200) <> 0;
stMCS2ChanParameter.stChannelState.bFollowingLimitReached := (n AND 16#00000400) <> 0;
stMCS2ChanParameter.stChannelState.bMovementFailed        := (n AND 16#00000800) <> 0;
stMCS2ChanParameter.stChannelState.bIsStreaming           := (n AND 16#00001000) <> 0;
stMCS2ChanParameter.stChannelState.bPositionerOverload    := (n AND 16#00002000) <> 0;
stMCS2ChanParameter.stChannelState.bOverTemperature       := (n AND 16#00004000) <> 0;
stMCS2ChanParameter.stChannelState.bReferenceMark         := (n AND 16#00008000) <> 0;
stMCS2ChanParameter.stChannelState.bIsPhased              := (n AND 16#00010000) <> 0;
stMCS2ChanParameter.stChannelState.bPositionerFault       := (n AND 16#00020000) <> 0;
stMCS2ChanParameter.stChannelState.bAmplifierEnabled      := (n AND 16#00040000) <> 0;
stMCS2ChanParameter.stChannelState.bInPosition            := (n AND 16#00080000) <> 0;
stMCS2ChanParameter.stChannelState.bBrakeEnabled          := (n AND 16#00100000) <> 0;

// Preserve a useful MCS2 diagnostic even if the asynchronous 0x603F read is
// delayed or unavailable. The SDO result, when available, replaces this
// inferred summary with the drive's exact code.
IF stMCS2ChanParameter.stChannelState.bRangeLimitReached THEN
    stMCS2ChanParameter.nMCS2ErrorCode := 16#8500;
ELSIF stMCS2ChanParameter.stChannelState.bEndStopReached THEN
    stMCS2ChanParameter.nMCS2ErrorCode := 16#7121;
ELSIF stMCS2ChanParameter.stChannelState.bFollowingLimitReached THEN
    stMCS2ChanParameter.nMCS2ErrorCode := 16#8611;
ELSIF stMCS2ChanParameter.stChannelState.bMovementFailed THEN
    stMCS2ChanParameter.nMCS2ErrorCode := 16#8600;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DecodeOptions" Id="{7f3a1c02-9b4e-4d21-8a6c-1e2f3a4b5c6d}">
      <Declaration><![CDATA[// ============================================================================
// DecodeOptions  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Decode the raw Referencing Options (0x200B) and Calibration
//           Options (0x2004) words read back from the drive into the
//           individual read-only flag fields of stMCS2ChanParameter.
// Usage   : Called once per cycle at the end of the body, so the flags follow
//           the latest read-back words. The words themselves stay the write
//           path (REF_OPT / CAL_OPT, io:io); only this decode is read-only.
// Inputs  : none (operates on the stMCS2ChanParameter reference)
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE DecodeOptions
VAR
    // Raw options word currently being decoded (referencing, then calibration).
    n : DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[n := stMCS2ChanParameter.nReferencingOpt;
stMCS2ChanParameter.bRefStartDirBackward   := (n AND 16#00000001) <> 0;
stMCS2ChanParameter.bRefReverseDir         := (n AND 16#00000002) <> 0;
stMCS2ChanParameter.bRefAutoZero           := (n AND 16#00000004) <> 0;
stMCS2ChanParameter.bRefAbortOnEndStop     := (n AND 16#00000008) <> 0;
stMCS2ChanParameter.bRefContinueOnRefFound := (n AND 16#00000010) <> 0;
stMCS2ChanParameter.bRefStopOnRefFound     := (n AND 16#00000020) <> 0;
stMCS2ChanParameter.bRefInvalidate         := (n AND 16#01000000) <> 0;

n := stMCS2ChanParameter.nCalibrationOpt;
stMCS2ChanParameter.bCalDirBackward        := (n AND 16#00000001) <> 0;
stMCS2ChanParameter.bCalDetectDistCodeInv  := (n AND 16#00000002) <> 0;
stMCS2ChanParameter.bCalAdvSensorCorr      := (n AND 16#00000004) <> 0;
stMCS2ChanParameter.bCalLimitedTravelRange := (n AND 16#00000100) <> 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EventQueueStep" Id="{0a000001-0000-0000-0000-00000000000a}">
      <Declaration><![CDATA[// ============================================================================
// EventQueueStep  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : One-shot read of the drive error code (0x603F) after a fault or
//           internal-limit event, and watchdog it.
// Usage   : Called once per cycle from the body. Highest priority of the three
//           queues, but still mutually exclusive with the fast and slow queues
//           so only one SDO is outstanding on the mailbox. Starts only when
//           bEvtReadPending is set, no slow read is in flight and the fast
//           queue is not in FAST_READING. A timeout is swallowed: an inferred
//           or previously read code is kept for diagnostics.
// Inputs  : none (uses bEvtReadPending, bSlowReadActive, eFast)
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE EventQueueStep
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eEvt OF

    EVT_IDLE:
        bExecDriveErrCode := FALSE;
        bEvtReadActive    := FALSE;
        tonEvtReadTimeout(IN := FALSE);
        IF bEvtReadPending
           AND NOT bSlowReadActive
           AND (eFast <> FAST_READING) THEN
            bEvtReadPending   := FALSE;
            bExecDriveErrCode := TRUE;
            bEvtReadActive    := TRUE;
            eEvt              := EVT_READING;
        END_IF

    EVT_READING:
        tonEvtReadTimeout(IN := TRUE, PT := tEvtReadTimeout);
        IF ftDriveErrCodeRead.Q THEN
            // Keep an inferred or previously read code if this mailbox read
            // fails. ChannelState provides a useful cause-level fallback.
            bExecDriveErrCode := FALSE;
            bEvtReadActive    := FALSE;
            tonEvtReadTimeout(IN := FALSE);
            eEvt              := EVT_IDLE;
        ELSIF tonEvtReadTimeout.Q THEN
            // Keep the inferred or previously read code for diagnostics.
            bExecDriveErrCode := FALSE;
            bEvtReadActive    := FALSE;
            tonEvtReadTimeout(IN := FALSE);
            eEvt              := EVT_IDLE;
        END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FastQueueStep" Id="{0a000001-0000-0000-0000-000000000001}">
      <Declaration><![CDATA[// ============================================================================
// FastQueueStep  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Poll ChannelState at the nReadTime cadence, the latency-sensitive
//           path interlocks depend on, and watchdog each read.
// Usage   : Called once per cycle from the body. Yields the bus to the slow and
//           event queues while one of their reads is in flight, but does not
//           back off any further -- as soon as that read completes the fast
//           read can fire. bFastReadNow forces an immediate read after a fault
//           or limit event. A failed or hung read is counted in
//           nFastReadFailures and retried on the next cadence.
// Inputs  : none (uses bFastReadNow, bSlowReadActive, bEvtReadActive)
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE FastQueueStep
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eFast OF

    FAST_IDLE:
        bExecChannelState := FALSE;
        eFast             := FAST_WAIT_CADENCE;

    FAST_WAIT_CADENCE:
        bExecChannelState := FALSE;
        tonFastReadTimeout(IN := FALSE);
        // Cadence timer runs while we're waiting for our next turn.
        tonFastCadence(
            IN := stMotionStage.bAxisParamsInit,
            PT := stMCS2ChanParameter.nReadTime
        );
        // Only fire when the cadence has elapsed AND the slow queue isn't
        // currently using the mailbox.
        IF (tonFastCadence.Q OR bFastReadNow) AND NOT bSlowReadActive AND NOT bEvtReadActive THEN
            tonFastCadence(IN := FALSE);
            bFastReadNow      := FALSE;
            bExecChannelState := TRUE;
            eFast             := FAST_READING;
        END_IF

    FAST_READING:
        // Hold execute TRUE through the read. F_TRIG on bBusy falling = done.
        tonFastReadTimeout(IN := TRUE, PT := tFastReadTimeout);
        IF ftChannelStateRead.Q THEN
            IF NOT fbChannelStateRead.bError THEN
                DecodeChannelState();
            ELSE
                // Don't stop polling on a single failure, and don't surface
                // it as a user-facing error -- it retries every cadence.
                nFastReadFailures := nFastReadFailures + 1;
            END_IF
            bExecChannelState := FALSE;
            tonFastReadTimeout(IN := FALSE);
            eFast             := FAST_WAIT_CADENCE;
        ELSIF tonFastReadTimeout.Q THEN
            // Hung read -- give up and retry next cadence.
            nFastReadFailures := nFastReadFailures + 1;
            bExecChannelState := FALSE;
            tonFastReadTimeout(IN := FALSE);
            eFast             := FAST_WAIT_CADENCE;
        END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlowQueueStep" Id="{0a000001-0000-0000-0000-000000000002}">
      <Declaration><![CDATA[// ============================================================================
// SlowQueueStep  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Sweep the NUM_SLOW slow-queue entries once at boot, then refresh
//           the whole table every tSlowReadInterval.
// Usage   : Called once per cycle from the body. One entry at a time; each read
//           is watchdogged by tSlowReadTimeout. A failed or hung read increments
//           nSlowReadFailures and advances -- it never stalls the sweep and
//           never affects the fast queue. Yields while a fast or event read is
//           in flight. Sets bFirstSlowSweepDone / bAllReadsComplete when a sweep
//           finishes.
// Inputs  : none (uses eSlow, nSlowIdx, bSlowReadActive)
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE SlowQueueStep
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eSlow OF

    SLOW_IDLE:
        ClearAllSlowExecutes();
        bSlowReadActive := FALSE;
        // Begin first sweep as soon as axis params are initialized.
        IF stMotionStage.bAxisParamsInit THEN
            nSlowIdx          := 1;
            nSlowReadFailures := 0;
            eSlow             := SLOW_RUNNING;
        END_IF

    SLOW_WAIT_CADENCE:
        ClearAllSlowExecutes();
        bSlowReadActive := FALSE;
        tonSlowCadence(
            IN := stMotionStage.bAxisParamsInit,
            PT := tSlowReadInterval
        );
        IF tonSlowCadence.Q THEN
            tonSlowCadence(IN := FALSE);
            nSlowIdx          := 1;
            nSlowReadFailures := 0;
            eSlow             := SLOW_RUNNING;
        END_IF

    SLOW_RUNNING:
        // Yield: never start a new slow read while the fast queue is
        // mid-read. Existing in-flight slow reads continue.
        IF NOT bSlowReadActive AND ((eFast = FAST_READING) OR bEvtReadActive) THEN
            // Just hold; don't kick the next read yet.
            RETURN;
        END_IF

        IF NOT bSlowReadActive THEN
            // Start the read at the current index.
            StartSlowRead(nSlowIdx);
            bSlowReadActive := TRUE;
            tonSlowReadTimeout(IN := FALSE);   // reset
        ELSE
            // Arm watchdog while we wait.
            tonSlowReadTimeout(IN := TRUE, PT := tSlowReadTimeout);
            IF SlowReadEdge(nSlowIdx) THEN
                // Normal completion path.
                IF SlowReadError(nSlowIdx) THEN
                    nSlowReadFailures := nSlowReadFailures + 1;
                END_IF
                ClearSlowExecute(nSlowIdx);
                bSlowReadActive := FALSE;
                tonSlowReadTimeout(IN := FALSE);
                nSlowIdx := nSlowIdx + 1;
            ELSIF tonSlowReadTimeout.Q THEN
                // Hung read -- force-clear and advance. The reader FB will
                // see bExecute drop; whether it ever asserts an edge later
                // is its problem, not ours.
                nSlowReadFailures := nSlowReadFailures + 1;
                ClearSlowExecute(nSlowIdx);
                bSlowReadActive := FALSE;
                tonSlowReadTimeout(IN := FALSE);
                nSlowIdx := nSlowIdx + 1;
            END_IF

            IF nSlowIdx > NUM_SLOW THEN
                // Sweep done.
                bFirstSlowSweepDone := TRUE;
                bAllReadsComplete   := TRUE;
                nSlowIdx            := 0;
                eSlow               := SLOW_WAIT_CADENCE;
            END_IF
        END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlowReadEdge" Id="{0a000001-0000-0000-0000-000000000006}">
      <Declaration><![CDATA[// ============================================================================
// SlowReadEdge  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Return TRUE on the cycle the read at index <idx> completes, i.e. on
//           the falling edge of that reader's bBusy.
// Usage   : Called from SLOW_RUNNING once per cycle while a slow read is in
//           flight. Maps the 1-based slow-queue index onto the matching F_TRIG,
//           so the index must stay in step with StartSlowRead.
// Inputs  : idx -- slow-queue table index, 1..NUM_SLOW (dimensionless).
// Returns : BOOL -- TRUE for exactly one cycle when that read finishes; FALSE
//           for an out-of-range index.
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE SlowReadEdge : BOOL
VAR_INPUT
    // Slow-queue table index, 1..NUM_SLOW. Values outside that range return
    // FALSE.
    idx : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE idx OF
    1:  SlowReadEdge := ftMaxCloseLoopFreqRead.Q;
    2:  SlowReadEdge := ftPositionerTypeRead.Q;
    3:  SlowReadEdge := ftCalibrationOptRead.Q;
    4:  SlowReadEdge := ftSensorPowerModeRead.Q;
    5:  SlowReadEdge := ftReferencingOptRead.Q;
    6:  SlowReadEdge := ftReferenceTypeRead.Q;
    7:  SlowReadEdge := ftSafeDirRead.Q;
    8:  SlowReadEdge := ftMotorLoadRead.Q;
    9:  SlowReadEdge := ftChannelTypeRead.Q;
    10: SlowReadEdge := ftLogicalScaleOffsetRead.Q;
    11: SlowReadEdge := ftLogicalScaleInvRead.Q;
    12: SlowReadEdge := ftChannelTempRead.Q;
    13: SlowReadEdge := ftMovementTypeRead.Q;
    14: SlowReadEdge := ftBaseUnitRead.Q;
    15: SlowReadEdge := ftBaseResolutionRead.Q;
    16: SlowReadEdge := ftDistCodeInvRead.Q;
    17: SlowReadEdge := ftPositionerCtrlOptRead.Q;
    18: SlowReadEdge := ftActuatorModeRead.Q;
    19: SlowReadEdge := ftMotorLoadProtRead.Q;
    20: SlowReadEdge := ftDiagClfMaxRead.Q;
    21: SlowReadEdge := ftDiagClfAvgRead.Q;
    22: SlowReadEdge := ftSoftLimMinRead.Q;
    23: SlowReadEdge := ftSoftLimMaxRead.Q;
    ELSE
        SlowReadEdge := FALSE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlowReadError" Id="{0a000001-0000-0000-0000-000000000007}">
      <Declaration><![CDATA[// ============================================================================
// SlowReadError  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Return the .bError flag of the reader for slow-queue index <idx>,
//           sampled after that read completed.
// Usage   : Called from SLOW_RUNNING on the completion edge, to decide whether
//           the finished read counts as a failure. Maps the index exactly like
//           SlowReadEdge.
// Inputs  : idx -- slow-queue table index, 1..NUM_SLOW (dimensionless).
// Returns : BOOL -- TRUE when the last attempt at that entry reported an error;
//           FALSE for an out-of-range index.
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE SlowReadError : BOOL
VAR_INPUT
    // Slow-queue table index, 1..NUM_SLOW. Values outside that range return
    // FALSE.
    idx : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE idx OF
    1:  SlowReadError := fbMaxCloseLoopFreqRead.bError;
    2:  SlowReadError := fbPositionerTypeRead.bError;
    3:  SlowReadError := fbCalibrationOptRead.bError;
    4:  SlowReadError := fbSensorPowerModeRead.bError;
    5:  SlowReadError := fbReferencingOptRead.bError;
    6:  SlowReadError := fbReferenceTypeRead.bError;
    7:  SlowReadError := fbSafeDirRead.bError;
    8:  SlowReadError := fbMotorLoadRead.bError;
    9:  SlowReadError := fbChannelTypeRead.bError;
    10: SlowReadError := fbLogicalScaleOffsetRead.bError;
    11: SlowReadError := fbLogicalScaleInvRead.bError;
    12: SlowReadError := fbChannelTempRead.bError;
    13: SlowReadError := fbMovementTypeRead.bError;
    14: SlowReadError := fbBaseUnitRead.bError;
    15: SlowReadError := fbBaseResolutionRead.bError;
    16: SlowReadError := fbDistCodeInvRead.bError;
    17: SlowReadError := fbPositionerCtrlOptRead.bError;
    18: SlowReadError := fbActuatorModeRead.bError;
    19: SlowReadError := fbMotorLoadProtRead.bError;
    20: SlowReadError := fbDiagClfMaxRead.bError;
    21: SlowReadError := fbDiagClfAvgRead.bError;
    22: SlowReadError := fbSoftLimMinRead.bError;
    23: SlowReadError := fbSoftLimMaxRead.bError;
    ELSE
        SlowReadError := FALSE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartSlowRead" Id="{0a000001-0000-0000-0000-000000000003}">
      <Declaration><![CDATA[// ============================================================================
// StartSlowRead  (PRIVATE)
// ----------------------------------------------------------------------------
// Purpose : Assert bExecute on the slow-queue entry at the given index, which
//           starts one SDO read.
// Usage   : Called from SLOW_RUNNING when no slow read is in flight. The caller
//           then sets bSlowReadActive and arms tSlowReadTimeout. The index must
//           stay in step with SlowReadEdge / SlowReadError / ClearSlowExecute.
// Inputs  : idx -- slow-queue table index, 1..NUM_SLOW (dimensionless).
// Returns : none
// History :
//   2026-11-28  Maintenance (documentation pass)  Header added; no logic change.
// ============================================================================
METHOD PRIVATE StartSlowRead
VAR_INPUT
    // Slow-queue table index, 1..NUM_SLOW. Values outside that range match no
    // CASE label, so no execute line is asserted.
    idx : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE idx OF
    1:  bExecMaxCloseLoopFreq   := TRUE;
    2:  bExecPositionerType     := TRUE;
    3:  bExecCalibrationOpt     := TRUE;
    4:  bExecSensorPowerMode    := TRUE;
    5:  bExecReferencingOpt     := TRUE;
    6:  bExecReferenceType      := TRUE;
    7:  bExecSafeDir            := TRUE;
    8:  bExecMotorLoad          := TRUE;
    9:  bExecChannelType        := TRUE;
    10: bExecLogicalScaleOffset := TRUE;
    11: bExecLogicalScaleInv    := TRUE;
    12: bExecChannelTemp        := TRUE;
    13: bExecMovementType       := TRUE;
    14: bExecBaseUnit           := TRUE;
    15: bExecBaseResolution     := TRUE;
    16: bExecDistCodeInv        := TRUE;
    17: bExecPositionerCtrlOpt  := TRUE;
    18: bExecActuatorMode       := TRUE;
    19: bExecMotorLoadProt      := TRUE;
    20: bExecDiagClfMax         := TRUE;
    21: bExecDiagClfAvg         := TRUE;
    22: bExecSoftLimMin         := TRUE;
    23: bExecSoftLimMax         := TRUE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>