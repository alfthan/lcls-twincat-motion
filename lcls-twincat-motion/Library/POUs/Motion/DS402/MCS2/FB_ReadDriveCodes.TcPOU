<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ReadDriveCodes" Id="{6ab55793-c2c3-4780-bb36-92684655a3d8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Purpose:
        Read the drive error codes after a motion or fault condition and surface
        them on ST_MotionStage, so the IOC reports a single operator message in
        sErrorMessage without the overlapping MCS2 and NC numeric code spaces
        being merged into nErrorId.
    Usage:
        Called once per PLC cycle from FB_MotionStageMCS2 on the owning stage's
        own structures:

            fbReadDriveCodes(
                bEnable             := stMotionStage.bAxisParamsInit AND
                                       stChanParams.bEnableHardwareOps,
                stDS402Drive        := stDS402Drive,
                stMotionStage       := stMotionStage,
                stMCS2ChanParameter := stChanParams);

        The block returns immediately while any of the three references is
        invalid, and has no outputs of its own: it writes stMotionStage.bError,
        .nErrorId (E_LCLSMotionError.MCS2_FAULT) and .sErrorMessage, plus
        stMCS2ChanParameter.sMCS2ErrorMessage.
    Objectives:
        - Decode stMCS2ChanParameter.nMCS2ErrorCode into sMCS2ErrorMessage
          through F_MCS2ErrorCodeLookup, for PLC debug on MCS2_ERR_MSG.
        - Promote a real-time MCS2 channel-state fault (following limit,
          positioner overload, over-temperature, positioner fault) that the NC
          never latched to stMotionStage.bError on the rising edge only, so a
          latched fault neither re-latches nor blocks the caller's reset.
        - Rebuild sErrorMessage from scratch each cycle - NC/limit layer first,
          then the raw MCS2 code in hex - so the two number spaces stay
          distinguishable for the operator.
    History:
        2026-03-04  ysmandza      Error reporting moved out of FB_MotionStage
                                  into this dedicated block.
        2026-08-16  Mandza        Standard message used for faults without a
                                  code.
        2026-08-31  Mandza        Raw MCS2 code appended to sErrorMessage.
        2026-09-01  Mandza        Fault promotion edge-triggered so a reset is
                                  not blocked; drive-only faults surfaced.
        2026-10-07  ysmandza      MovementFailed dropped from the fault check.
        2026-11-28  Scirix Agent  POU header and per-declaration comments added,
                                  no behaviour change (audit finding #150).
*)
FUNCTION_BLOCK FB_ReadDriveCodes
VAR_IN_OUT
    // Drive PDO image of this stage's EtherCAT slave. Only the TPDO status word
    // is read here (stDriveStatus.InternalLimitActive, which selects the
    // NC/limit message); no drive output is written.
    stDS402Drive         : ST_DS402Drive;
    // Stage state owned by the caller. This FB sets bError, nErrorId and
    // sErrorMessage on it and touches nothing else.
    stMotionStage        : ST_MotionStage;
    // MCS2 channel parameters of the same stage, filled in by
    // FB_ReadChanParameters: nMCS2ErrorCode / sMCS2ErrorMessage are written and
    // stChannelState is read for the fault-promotion bits.
    stMCS2ChanParameter  : ST_MCS2ChanParameter;
END_VAR
VAR_INPUT
    // TRUE when the axis parameters are initialised and hardware operations are
    // permitted (stMotionStage.bAxisParamsInit AND
    // stChanParams.bEnableHardwareOps). Gates the MCS2 fault promotion only:
    // while FALSE no MCS2 channel-state fault is latched. The error-code decode
    // and the sErrorMessage rebuild run regardless.
    bEnable : BOOL;
END_VAR
VAR
    {attribute 'hide'}
    // Motion error logger instance. This FB reports through stMotionStage
    // directly, so the instance is currently not called.
    fbLogError          : FB_LogMotionError;
    // sErrorMessage being rebuilt on this cycle.
    sMsg                : STRING;
    // 'MCS2: 0xXXXX' fragment appended to sMsg.
    sMCS2Code           : STRING;
    // Level signal: OR of the promoted channel-state fault bits, gated by
    // bEnable.
    bMCS2Fault          : BOOL;
    // Rising edge of bMCS2Fault: latches the fault exactly once.
    rtMCS2Fault         : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(stDS402Drive)
    OR NOT __ISVALIDREF(stMotionStage)
    OR NOT __ISVALIDREF(stMCS2ChanParameter) THEN
    RETURN;
END_IF

// The drive-side code (0x603F) is read by FB_ReadChanParameters on a fault or
// internal-limit event. It is decoded by its own table and never merged into
// nErrorId: the two number spaces overlap (MCS2 0x4200 sits inside the NC 0x4xxx
// family, and MCS2 manufacturer codes 0xFFxx overlap E_LCLSMotionError.TEST).
// The decoded string and raw code stay on MCS2_ERR_MSG / MCS2_ERR for PLC debug;
// only the raw code is surfaced to the operator via sErrorMessage below.
stMCS2ChanParameter.sMCS2ErrorMessage :=
    F_MCS2ErrorCodeLookup(nErrorId := stMCS2ChanParameter.nMCS2ErrorCode);

// Promote a genuine MCS2 fault the NC never latched (a drive-side stop that
// does not disturb the NC position loop). Only real-time conditions qualify,
// checked in any op mode: Overload/OverTemperature/PositionerFault hold for as
// long as the condition is physically present, and FollowingLimitReached is
// the firmware's own Following Error Window (0x6065) protective stop, which
// it enforces continuously, including during CSP streaming.
//
// MovementFailed is excluded: it describes the outcome of a discrete
// MCS2-native move (home/step/calibrate), which CSP never issues. CSP only
// streams continuous setpoints, so in CSP that bit can only ever be a stale
// leftover from an earlier open-loop move, not a live result, and surfacing
// it there faulted CSP moves that had actually succeeded. The open-loop
// routines already detect their own move failures via the DS402 status word
// (see FB_MCS2Home/FB_MCS2StepMode/FB_MCS2Calibrate).
//
// Edge-triggered so it reports once: a reset clears bError, and a
// still-asserted condition does not re-latch and block the reset. A fresh
// fault re-fires on the next rising edge.
bMCS2Fault :=
    bEnable
    AND (stMCS2ChanParameter.stChannelState.bFollowingLimitReached
         OR stMCS2ChanParameter.stChannelState.bPositionerOverload
         OR stMCS2ChanParameter.stChannelState.bOverTemperature
         OR stMCS2ChanParameter.stChannelState.bPositionerFault);

rtMCS2Fault(CLK := bMCS2Fault);
IF rtMCS2Fault.Q AND NOT stMotionStage.bError THEN
    stMotionStage.bError   S= TRUE;
    stMotionStage.nErrorId := E_LCLSMotionError.MCS2_FAULT;
END_IF

// sErrorMessage is the only message channel exposed to the IOC. Rebuild it from
// scratch each cycle so the MCS2 layer, an SDO read that lands several cycles
// after bError latches, merges in exactly once it is available, without ever
// duplicating. The numeric values stay separate in PLC:nErrorId and MCS2_ERR so
// the overlapping code spaces cannot be confused.
IF stMotionStage.bError THEN
    sMsg := '';

    // NC / limit layer: whatever the NC side could see.
    IF stDS402Drive.stDriveStatus.InternalLimitActive
        AND stMotionStage.sCustomErrorMessage <> '' THEN
        sMsg := stMotionStage.sCustomErrorMessage;
    ELSIF stMotionStage.nErrorId >= 16#4000 THEN
        sMsg := F_MotionErrorCodeLookup(nErrorId := stMotionStage.nErrorId);
    ELSIF stMotionStage.sCustomErrorMessage <> '' THEN
        sMsg := stMotionStage.sCustomErrorMessage;
    ELSIF stMotionStage.nErrorId = 0 AND stMCS2ChanParameter.nMCS2ErrorCode = 0 THEN
        sMsg := 'Contact PCDS to add new message';
    END_IF

    // MCS2 layer: append the raw drive code (hex) whenever one exists.
    IF stMCS2ChanParameter.nMCS2ErrorCode <> 0 THEN
        sMCS2Code := CONCAT('MCS2: 0x',
            WORD_TO_HEXSTR(in := stMCS2ChanParameter.nMCS2ErrorCode, iPrecision := 4, bLoCase := 0));
        IF sMsg <> '' THEN
            sMsg := CONCAT(CONCAT(sMsg, ' ('), CONCAT(sMCS2Code, ')'));
        ELSE
            sMsg := sMCS2Code;
        END_IF
    END_IF

    IF sMsg <> '' THEN
        stMotionStage.sErrorMessage := sMsg;
    END_IF
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>