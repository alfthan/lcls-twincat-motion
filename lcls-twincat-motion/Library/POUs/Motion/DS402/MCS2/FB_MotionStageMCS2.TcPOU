<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionStageMCS2" Id="{8a1beccb-8ae6-4cef-98b6-1d3261aefb9e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    MCS2 Motion Stage
    Controls a stage in CSP (NC), STEP_MODE, and Homing via DS402 interface.
    - Uses overridden Position Holding timer.
    - power enable mode must be 'DURING_MOTION' for closed-loop (CSP) control.
    - Set bServo PV to true for closed-loop, clear for open-loop (step mode).

    Interface: the motor record / NC state and the MCS2 channel parameters are
    bound through the single VAR_IN_OUT interface struct ST_MCS2AxisInterface, so
    a caller wires one reference instead of two REFERENCE TO variables.

    History:
        2026-11-27  scirix agent  Replaced the two REFERENCE TO members with the
                                  single ST_MCS2AxisInterface VAR_IN_OUT (audit
                                  finding 1093, convention conv_83a907114111).
*)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_MotionStageMCS2

VAR_IN_OUT
    // Single MCS2 axis interface: the motor record / NC state and the channel parameters
    iq_stAxis : ST_MCS2AxisInterface;
END_VAR
VAR
    // Hardware I/O
    {attribute 'pytmc' := 'pv:'}
    stDS402Drive		: ST_DS402Drive;

    fbDriveManager		: FB_MCS2DriveManager;
    fbReadChanParams	: FB_ReadChanParameters;
    fbStepMode 			: FB_MCS2StepMode;
    fbhome 				: FB_MCS2Home;
    fbCalibrate			: FB_MCS2Calibrate;
    fbWriteParameters 	: FB_WriteChanParameters;
    fbReadDriveCodes 	: FB_ReadDriveCodes;

    {attribute 'hide'}
    eModule                 : E_Module;
    {attribute 'hide'}
    eDoneCause              : E_MoveDoneCause := E_MoveDoneCause.Unknown;
    {attribute 'hide'}
    fbMcPower               : MC_Power;
    {attribute 'hide'}
    fbMcMoveAbsolute        : MC_MoveAbsolute;
    {attribute 'hide'}
    fbMcHalt                : MC_Halt;
    {attribute 'hide'}
    fbMcReset               : MC_Reset;
    {attribute 'hide'}
    fbMcWriteParameter      : MC_WriteParameter;
    {attribute 'hide'}
    fbMcReadParams          : MC_ReadParameterSet;
    {attribute 'hide'}
    fParameterValue : LREAL;
    fMeasuredPos: LREAL;
    fMeasuredVelo: LREAL;
    fMeasuredAcc: LREAL;
    bLastHoltTimeOut : BOOL;
    bRestoreWaitRetry   : BOOL;
    {attribute 'hide'}
    bEnPosLag               : BOOL;
    {attribute 'hide'}
    bWrongParameter         : BOOL;
    {attribute 'hide'}
    bExecMove               : BOOL;
    {attribute 'hide'}
    bExecHome               : BOOL;
    {attribute 'hide'}
    bNewMoveReq             : BOOL;
    {attribute 'hide'}
    bPrepareDisable         : BOOL;
    {attribute 'hide'}
    bHalt                   : BOOL;
    {attribute 'hide'}
    bLimOverride            : BOOL;
    {attribute 'hide'}
    bPositionHold           : BOOL;
    {attribute 'hide'}
    bLocalExec              : BOOL;
    {attribute 'hide'}
    bSystemInit             : BOOL;
    {attribute 'hide'}
    bRestoreLoad             : BOOL;
    {attribute 'hide'}
    bExecParamRead          : BOOL;

    {attribute 'hide'}
    bRecentEnPosLagStatus    : BOOL;

    {attribute 'hide'}
    bLagClearPending         : BOOL;
    {attribute 'hide'}
    tonLagClearTimeout       : TON;
    {attribute 'hide'}
    rtMcWriteDone            : R_TRIG;

    {attribute 'hide'}
    bReset                   : BOOL;
    bFault : BOOL := FALSE;
    {attribute 'hide'}
    nCmdDataLocal            : INT;
    tonHoldTime              : TON;
    {attribute 'hide'}
    NCParamsTimer            : TON;
    {attribute 'hide'}
    tonRestoreRetry          : TON;
    {attribute 'hide'}
    rtExec                   : R_TRIG;
    {attribute 'hide'}
    rtMoveCmdShortcut        : R_TRIG;
    {attribute 'hide'}
    rtHomeCmdShortcut        : R_TRIG;
    {attribute 'hide'}
    rtEnableMode             : R_TRIG;
    {attribute 'hide'}
    rtUserExec               : R_TRIG;
    {attribute 'hide'}
    rtMoveDone               : R_TRIG;
    {attribute 'hide'}
    rtNewMoveReq             : R_TRIG;
    {attribute 'hide'}
    ftExec                   : F_TRIG;
    rtHaltEdge : R_TRIG;
    {attribute 'hide'}
    rtStepCmdShortcut		 : R_TRIG;
    {attribute 'hide'}
    rtStepFwdCmdShortcut	 : R_TRIG;
    {attribute 'hide'}
    rtStepRevCmdShortcut	 : R_TRIG;
    {attribute 'hide'}
    rtCalibrateCmdShortcut	 : R_TRIG;
    {attribute 'hide'}
    tSDOOpsTimer 			 : TON;
    {attribute 'hide'}
    bParamsEnable			 : BOOL;
    {attribute 'hide'}
    bDelayReadAtInit 		 : BOOL;
    bBaseExec: BOOL;
    nCommandLocal  			 : E_MCS2OpMode := E_MCS2OpMode.CSP;
END_VAR

VAR CONSTANT
    {attribute 'hide'}
    nChanSoftLimitBase       : WORD := 16#200E;
    {attribute 'hide'}
    nChanHomeOffsetBase      : WORD := 16#607C;
    {attribute 'hide'}
    nChanHomeMethodBase      : WORD := 16#6098;
    {attribute 'hide'}
    nChanHomingSpeedBase     : WORD := 16#6099;
    {attribute 'hide'}
    nChanhomingAccBase       : WORD := 16#609A;
    {attribute 'hide'}
    nChanErrorCodeBase       : WORD := 16#603F;
    {attribute 'hide'}
    nChanFErrWinBase         : WORD := 16#6065;
    {attribute 'hide'}
    nChanOfsBase             : WORD := 16#800;      // For SmartAct MCS2 and E-727
    {attribute 'hide'}
    nChanEncErrorCode        : WORD := 16#7300;     // Motor encoder defective code (for save/restore)
    {attribute 'hide'}
    nChanSoftLimBase         : WORD := 16#200E;
    {attribute 'hide'}
    nChanOlStepBase          : WORD := 16#2022;
    {attribute 'hide'}
    nChanOlStepAmpBase       : WORD := 16#2023;
    {attribute 'hide'}
    nChanOlStepFreqBase      : WORD := 16#2024;
    {attribute 'hide'}
    nChanMaxCloseLoopFreqBase: WORD := 16#2001;
    {attribute 'hide'}
    nChanPositionerTypeBase  : WORD := 16#2000;
    {attribute 'hide'}
    nCHanCalibrationOptBase  : WORD := 16#2004;
    {attribute 'hide'}
    nChanSensorPowerModeBase : WORD := 16#2007;
    {attribute 'hide'}
    nChanReferencingOptBase  : WORD := 16#200B;
    {attribute 'hide'}
    nChanReferenceTypeBase   : WORD := 16#200A;
    {attribute 'hide'}
    nChanSafeDirBase         : WORD := 16#200C;
    {attribute 'hide'}
    nChanMotorLoadBase       : WORD := 16#200D;
    {attribute 'hide'}
    nChannelTypeBase         : WORD := 16#200F;
    {attribute 'hide'}
    nChannelStateBase        : WORD := 16#2025;
    {attribute 'hide'}
    nChanLogicalScaleOffsetBase  : WORD := 16#2008;
    {attribute 'hide'}
    nChanLogicalScaleInvBase     : WORD := 16#2009;
    {attribute 'hide'}
    nChanChannelTempBase         : WORD := 16#2026;
    {attribute 'hide'}
    nChanMovementTypeBase        : WORD := 16#2003;
    {attribute 'hide'}
    nChanBaseUnitBase            : WORD := 16#2005;
    {attribute 'hide'}
    nChanBaseResolutionBase      : WORD := 16#2006;
    {attribute 'hide'}
    nChanDistCodeInvBase         : WORD := 16#2029;
    {attribute 'hide'}
    nChanPositionerCtrlOptBase   : WORD := 16#2027;
    {attribute 'hide'}
    nChanActuatorModeBase        : WORD := 16#2028;
    {attribute 'hide'}
    nChanMotorLoadProtBase       : WORD := 16#202B;
    {attribute 'hide'}
    nChanDiagClfBase             : WORD := 16#202A;
    // Held as constants so the retract check below cannot drift from the text posted.
    {attribute 'hide'}
    sMsgPosLimit                 : STRING := 'Cannot move past positive limit.';
    {attribute 'hide'}
    sMsgNegLimit                 : STRING := 'Cannot move past Negative limit.';
END_VAR

VAR PERSISTENT
    bSaved                   : BOOL;
    fSavedPosition           : LREAL;
    bLastPositiveDirection   : BOOL;
    bLastNegativeDirection   : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(iq_stAxis) THEN
    RETURN;
END_IF

// When the PLC autoboots, I/O is not yet valid after 'call_after_init'
IF bSystemInit THEN
    IF iq_stAxis.stMotionStage.Axis.NcToPlc.AxisId <> 0 THEN
        bExecParamRead	:= TRUE;
        iq_stAxis.stChanParams.bStageReady  := TRUE;
        bSystemInit	:= FALSE;
        iq_stAxis.stChanParams.fPosition    := iq_stAxis.stMotionStage.Axis.NcToPlc.ActPos;
    END_IF
END_IF

(*
  Shortcut command edge detection
  Move requests can arrive via bMoveCmd (shortcut) or directly via bExecute
*)
rtMoveCmdShortcut    (CLK := iq_stAxis.stMotionStage.bMoveCmd);
rtHomeCmdShortcut    (CLK := iq_stAxis.stMotionStage.bHomeCmd);
rtStepCmdShortcut    (CLK := iq_stAxis.stChanParams.bStepMoveCmd);
rtStepFwdCmdShortcut (CLK := iq_stAxis.stChanParams.bStepForwardCmd);
rtStepRevCmdShortcut (CLK := iq_stAxis.stChanParams.bStepReverseCmd);
rtCalibrateCmdShortcut(CLK := iq_stAxis.stChanParams.bCalibrationCmd);

IF rtMoveCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    iq_stAxis.stMotionStage.bExecute := TRUE;
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.MOVE_ABSOLUTE;
    bEnPosLag              := bRecentEnPosLagStatus;
    fParameterValue        := BOOL_TO_LREAL(bRecentEnPosLagStatus);

ELSIF rtStepCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    iq_stAxis.stMotionStage.bExecute := TRUE;
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.JOG;
    bEnPosLag              := bRecentEnPosLagStatus;
    fParameterValue        := BOOL_TO_LREAL(bRecentEnPosLagStatus);

ELSIF rtStepFwdCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    // Forward jog: drive the step count positive, then step
    iq_stAxis.stChanParams.nChanStep := ABS(iq_stAxis.stChanParams.nChanStep);
    iq_stAxis.stMotionStage.bExecute := TRUE;
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.JOG;
    bEnPosLag              := bRecentEnPosLagStatus;
    fParameterValue        := BOOL_TO_LREAL(bRecentEnPosLagStatus);

ELSIF rtStepRevCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    // Reverse jog: drive the step count negative, then step
    iq_stAxis.stChanParams.nChanStep := -ABS(iq_stAxis.stChanParams.nChanStep);
    iq_stAxis.stMotionStage.bExecute := TRUE;
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.JOG;
    bEnPosLag              := bRecentEnPosLagStatus;
    fParameterValue        := BOOL_TO_LREAL(bRecentEnPosLagStatus);

ELSIF rtCalibrateCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    iq_stAxis.stMotionStage.bExecute := TRUE;
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.CALIBRATE;
    bRecentEnPosLagStatus := iq_stAxis.stMotionStage.stAxisParameters.bCtrlEnablePosDiffControl.0;
    // Trigger WriteParameterNC to disable position lag during calibration.
    bEnPosLag             := bRecentEnPosLagStatus;
    // Write 0 = disable position lag monitoring.
    fParameterValue       := 0;
    bLagClearPending      := bRecentEnPosLagStatus;

ELSIF rtHomeCmdShortcut.Q AND NOT iq_stAxis.stMotionStage.bExecute THEN
    iq_stAxis.stMotionStage.nCommand := E_EpicsMotorCmd.HOME;
    iq_stAxis.stMotionStage.nCmdData := iq_stAxis.stChanParams.eHomeMode;
    iq_stAxis.stMotionStage.bExecute := (iq_stAxis.stChanParams.eHomeMode = E_MCS2HomeMethod.AutoMethod)
                              OR (iq_stAxis.stChanParams.eHomeMode = E_MCS2HomeMethod.CurrentPositionMethod);

    bRecentEnPosLagStatus := iq_stAxis.stMotionStage.stAxisParameters.bCtrlEnablePosDiffControl.0;
    // Trigger WriteParameterNC to disable position lag during homing.
    bEnPosLag             := bRecentEnPosLagStatus;
    // Write 0 = disable position lag monitoring.
    fParameterValue       := 0;
    bLagClearPending      := bRecentEnPosLagStatus;
END_IF

// Main execute edge: covers both shortcut and direct bExecute paths
rtUserExec(CLK := iq_stAxis.stMotionStage.bExecute);

// Valid move request: not busy, rising execute edge, no error
bNewMoveReq S= NOT iq_stAxis.stMotionStage.bBusy AND rtUserExec.Q AND NOT iq_stAxis.stMotionStage.bError;
bNewMoveReq R= NOT iq_stAxis.stMotionStage.bExecute OR iq_stAxis.stMotionStage.bError;
bPrepareDisable R= bNewMoveReq;

IF rtUserExec.Q THEN
    //nCommandLocal := iq_stAxis.stMotionStage.nCommand;
    // Cover direct bExecute path, shortcut path already set bEnPosLag/fParameterValue
    IF NOT rtMoveCmdShortcut.Q
        AND NOT rtStepCmdShortcut.Q
        AND NOT rtCalibrateCmdShortcut.Q
        AND NOT rtHomeCmdShortcut.Q
    THEN
        IF iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.HOME
            OR iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.CALIBRATE THEN
            bRecentEnPosLagStatus := iq_stAxis.stMotionStage.stAxisParameters.bCtrlEnablePosDiffControl.0;
            bEnPosLag             := bRecentEnPosLagStatus;
            fParameterValue       := 0;
            bLagClearPending      := bRecentEnPosLagStatus;
        ELSE
            bEnPosLag       := bRecentEnPosLagStatus;
            fParameterValue := BOOL_TO_LREAL(bRecentEnPosLagStatus);
        END_IF
    END_IF

    IF NOT iq_stAxis.stMotionStage.bHomeCmd
        AND NOT iq_stAxis.stChanParams.stChannelState.bIsReferenced THEN
        IF iq_stAxis.stChanParams.eHomeMode <> E_EpicsHomeCmd.NONE
            AND NOT iq_stAxis.stMotionStage.bHomed THEN
            iq_stAxis.stMotionStage.sErrorMessage := 'Axis homing mode set, but homing routine pending';
        END_IF
    END_IF
END_IF

// Drive manager
fbDriveManager(
    stMotionStage        := iq_stAxis.stMotionStage,
    stDS402Drive         := stDS402Drive,
    stMCS2ChanParameter  := iq_stAxis.stChanParams,
    bUserExec            := rtUserExec.Q,
    eRequestedManualMode => nCommandLocal
);

// Enable mode handling
rtEnableMode(CLK := (iq_stAxis.stMotionStage.nEnableMode = E_StageEnableMode.DURING_MOTION));

CASE iq_stAxis.stMotionStage.nEnableMode OF
    E_StageEnableMode.ALWAYS:
        iq_stAxis.stMotionStage.bEnable := iq_stAxis.stMotionStage.bSafetyReady;

    E_StageEnableMode.DURING_MOTION:
        IF rtEnableMode.Q THEN
            iq_stAxis.stMotionStage.bEnable := FALSE;
        END_IF
        IF bNewMoveReq THEN
            bPositionHold        := FALSE;
            tonHoldTime.IN       := FALSE;
            iq_stAxis.stMotionStage.bEnable:= iq_stAxis.stMotionStage.bSafetyReady;
            bLastHoltTimeOut     := FALSE;
            bHalt                := FALSE;
        END_IF
END_CASE

// Interlock: Reacts on internal limit conditions
Interlock();

bBaseExec := NOT iq_stAxis.stMotionStage.bError
             AND iq_stAxis.stMotionStage.bExecute
             AND iq_stAxis.stMotionStage.bAllEnable
             AND iq_stAxis.stMotionStage.bSafetyReady;

IF fbDriveManager.bCSPModeEnabled THEN
    // Close loop: gate on NC standstill state (bEnableDone)
    bLocalExec := bBaseExec
                  AND iq_stAxis.stMotionStage.bEnableDone
                  AND iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.MOVE_ABSOLUTE;

ELSIF fbDriveManager.bHomeModeEnabled THEN
    // Open loop homing: gate on DS402 operational state
    bLocalExec := bBaseExec
                  AND fbDriveManager.bOperational
                  AND iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.HOME;

ELSIF fbDriveManager.bStepModeEnabled THEN
    // Open loop step: gate on DS402 operational state
    bLocalExec := bBaseExec
                  AND fbDriveManager.bOperational
                  AND iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.JOG;

ELSIF fbDriveManager.bCalibrationModeEnabled THEN
    // Open loop calibration: gate on DS402 operational state
    bLocalExec := bBaseExec
                  AND fbDriveManager.bOperational
                  AND iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.CALIBRATE;
ELSE
    bLocalExec := FALSE;
END_IF

bExecMove := bLocalExec AND ((iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.MOVE_ABSOLUTE)
                          OR  (iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.JOG)
                          OR  (iq_stAxis.stMotionStage.nCommand = E_EpicsMotorCmd.CALIBRATE));
bExecHome := bLocalExec AND NOT bExecMove;

rtExec(CLK := bLocalExec);
IF rtExec.Q THEN
    stDS402Drive.nDriveControl.8 := FALSE;
    iq_stAxis.stMotionStage.bDone          := FALSE;
END_IF


IF NOT fbDriveManager.bDS402Manual THEN
    iq_stAxis.stMotionStage.Axis.ReadStatus();
END_IF

// Get definitive bEnableDone from NC axis state
CASE iq_stAxis.stMotionStage.Axis.Status.MotionState OF
    MC_AXISSTATE_UNDEFINED, MC_AXISSTATE_DISABLED, MC_AXISSTATE_ERRORSTOP:
        iq_stAxis.stMotionStage.bEnableDone := FALSE;
    ELSE
        iq_stAxis.stMotionStage.bEnableDone := TRUE;
END_CASE

// Reset handling
IF iq_stAxis.stMotionStage.bReset THEN
    iq_stAxis.stMotionStage.bExecute          := FALSE;
    iq_stAxis.stMotionStage.bError            := FALSE;
    iq_stAxis.stMotionStage.nErrorId          := 0;
    iq_stAxis.stMotionStage.sErrorMessage     := '';
    iq_stAxis.stMotionStage.sCustomErrorMessage := '';
    iq_stAxis.stChanParams.nMCS2ErrorCode     := 0;
    iq_stAxis.stChanParams.sMCS2ErrorMessage   := '';
    fbStepMode.Reset();
    fbhome.Reset();
    bReset := TRUE;
    bLagClearPending := FALSE;
    IF fbDriveManager.bDS402Manual THEN
        stDS402Drive.nDriveControl.7 := TRUE;
    END_IF
    iq_stAxis.stMotionStage.bReset := FALSE;
END_IF

// Stop/halt detection. bHalt is the user-stop channel only: execute dropped
// mid-move. Limit reaction is handled by the direction enables, not from here.
ftExec(CLK := iq_stAxis.stMotionStage.bExecute);
bHalt := ftExec.Q AND iq_stAxis.stMotionStage.bBusy;
rtHaltEdge(CLK := bHalt);
IF rtHaltEdge.Q AND fbDriveManager.bDS402Manual THEN
    fbStepMode.Halt();
    fbhome.Halt();
    stDS402Drive.nDriveControl.8 := TRUE;
END_IF

WriteParameterNC(
    Execute         := bEnPosLag,
    ParameterNumber := MC_AxisParameter.AxisEnPositionLagMonitoring,
    ParameterValue  := fParameterValue
);

// Hold the open-loop home/calibrate move until the NC position-lag disable actually
// lands, so the drive's referencing move cannot trip a following error on residual lag
// monitoring. Timeout caps the wait so a missing write cannot hang the routine.
rtMcWriteDone(CLK := fbMcWriteParameter.Done);
tonLagClearTimeout(IN := bLagClearPending, PT := T#500MS);
IF bLagClearPending
   AND ((fParameterValue = 0 AND rtMcWriteDone.Q) OR tonLagClearTimeout.Q) THEN
    bLagClearPending := FALSE;
END_IF

bParamsEnable := iq_stAxis.stMotionStage.bAxisParamsInit AND iq_stAxis.stChanParams.bEnableHardwareOps;

fbWriteParameters(
    bEnable             := bParamsEnable,
    bErrorAcknowledge   := iq_stAxis.stMotionStage.bReset,
    stDS402Drive        := stDS402Drive,
    stMotionStage       := iq_stAxis.stMotionStage,
    stChanParams := iq_stAxis.stChanParams
);

CASE nCommandLocal OF
    E_MCS2OpMode.CSP:
        Reset();
        Power();
        Halt();
        (*Wait for drive to be in the correct mode after a request was validated *)
        MoveAbsolute();
        (*
          IN CSP mode the drive control word is update via the NC
          Manual step mode and Homing will override this
        *)

        stDS402Drive.nModeOfOperation := stDS402Drive.nModeOfOperationNC;
        stDS402Drive.nDriveControl    := stDS402Drive.nDriveControlNC;

    E_MCS2OpMode.HOME:
        (*DS402 Manual Homing*)
        // Gate on the drive manager confirming HOME mode is active and operational.
        fbhome(
            bExecute := bExecHome AND fbWriteParameters.bParamsSet AND NOT bLagClearPending
                        AND fbDriveManager.bHomeModeEnabled,
            stDS402Drive  := stDS402Drive,
            stMotionStage := iq_stAxis.stMotionStage
        );

    E_MCS2OpMode.STEP:
        fbStepMode(
            bExecute       := bExecMove AND fbWriteParameters.bParamsSet
                              AND fbDriveManager.bStepModeEnabled,
            stDS402Drive  := stDS402Drive,
            stMotionStage := iq_stAxis.stMotionStage
        );

    E_MCS2OpMode.CALIBRATE:
        fbCalibrate(
            bExecute	 := bExecMove AND fbWriteParameters.bParamsSet AND NOT bLagClearPending
                          AND fbDriveManager.bCalibrationModeEnabled,
            stDS402Drive  := stDS402Drive,
            stMotionStage := iq_stAxis.stMotionStage
        );
END_CASE

iq_stAxis.stMotionStage.bBusy := fbMcMoveAbsolute.Busy
                       OR fbhome.bHomeMoveBusy
                       OR fbStepMode.bStepMoveBusy
                       OR fbCalibrate.bCalibrateMoveBusy;
// Check done moving via user stop, limit hit, Target Position reached, or from homing.
PostMoveChecks();
// update encoder value and calibrated position
ScaleEncRawValue();
// Drive parameters
ExposedParameters(Enable := iq_stAxis.stChanParams.bStageReady, tRefreshDelay := T#2S);
// Read MCS2 Channel Parameters
fbReadChanParams(
    bEnable             := bParamsEnable,
    stMotionStage       := iq_stAxis.stMotionStage,
    stMCS2ChanParameter := iq_stAxis.stChanParams,
    stDS402Drive        := stDS402Drive,
);
(* Save and restore as long as not an absolute encoder*)
PersistParameters(Enable := iq_stAxis.stChanParams.bStageReady);
(*Restore encoder value at initialization*)
RestoreMotionParams(Enable := iq_stAxis.stChanParams.bStageReady);
(*EPICS Motor record Update*)
UpdateEpicsStatus();

(*
    Error from functions and Nc. The error will send to EPICS interface based on predifined
    priority: axis, power, backlash, absoluteMove, etc...
*)
IF fbMcPower.Error AND fbMcPower.Active THEN
    iq_stAxis.stMotionStage.bError   := fbMcPower.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcPower.ErrorID;
ELSIF fbMcMoveAbsolute.Error THEN
    iq_stAxis.stMotionStage.bError   := fbMcMoveAbsolute.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcMoveAbsolute.ErrorID;
ELSIF fbMcHalt.Error AND fbMcHalt.Active THEN
    iq_stAxis.stMotionStage.bError   := fbMcHalt.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcHalt.ErrorID;
ELSIF fbMcReset.Error THEN
    iq_stAxis.stMotionStage.bError   := fbMcReset.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcReset.ErrorID;
ELSIF fbMcWriteParameter.Error THEN
    iq_stAxis.stMotionStage.bError   := fbMcWriteParameter.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcWriteParameter.ErrorID;
ELSIF fbMcReadParams.Error AND NOT iq_stAxis.stMotionStage.bBusy THEN
    iq_stAxis.stMotionStage.bError   := fbMcReadParams.Error;
    iq_stAxis.stMotionStage.nErrorId := fbMcReadParams.ErrorID;
ELSE
    IF iq_stAxis.stMotionStage.bBusy THEN
        // Clear the display message during normal motion, but leave sCustomErrorMessage
        // intact: Interlock may have just set it on this same cycle, and the NC error
        // that latches bError will not be visible until the next cycle.
        iq_stAxis.stMotionStage.sErrorMessage := '';
    END_IF
END_IF

(*Double function, prioritize NC error otherwise read drive channel error code*)
fbReadDriveCodes(
    bEnable             := bParamsEnable,
    stMotionStage       := iq_stAxis.stMotionStage,
    stMCS2ChanParameter := iq_stAxis.stChanParams,
    stDS402Drive        := stDS402Drive,
);

IF iq_stAxis.stMotionStage.sCustomErrorMessage <> ''
    AND iq_stAxis.stMotionStage.sErrorMessage = '' THEN
    iq_stAxis.stMotionStage.sErrorMessage := iq_stAxis.stMotionStage.sCustomErrorMessage;
END_IF

(*Clear motion flag when error occurs*)
IF iq_stAxis.stMotionStage.bError THEN
    iq_stAxis.stMotionStage.bExecute := FALSE;
    iq_stAxis.stMotionStage.bBusy    := FALSE;
    iq_stAxis.stMotionStage.bDone    := FALSE;
    iq_stAxis.stMotionStage.bEnable  := FALSE;
END_IF

(* We've got the rising edge clear these flags.*)
iq_stAxis.stMotionStage.bMoveCmd             := FALSE;
iq_stAxis.stMotionStage.bHomeCmd             := FALSE;
iq_stAxis.stChanParams.bStepMoveCmd   := FALSE;
iq_stAxis.stChanParams.bStepForwardCmd := FALSE;
iq_stAxis.stChanParams.bStepReverseCmd := FALSE;
iq_stAxis.stChanParams.bCalibrationCmd := FALSE;
]]></ST>
    </Implementation>
    <Method Name="ExposedParameters" Id="{bfdcb735-2f35-43ca-9b4a-eca418143c19}">
      <Declaration><![CDATA[METHOD PUBLIC  ExposedParameters
VAR_INPUT
    Enable : BOOL;
    tRefreshDelay: TIME;
END_VAR

VAR_INST
    {attribute 'hide'}
    bParamReadTimer     : BOOL := TRUE;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Periodic update of NC parameters
NCParamsTimer( IN:=Enable AND NOT bExecParamRead, PT:=tRefreshDelay);
bExecParamRead S= NCParamsTimer.Q;
fbMcReadParams(
    Parameter:= iq_stAxis.stMotionStage.stAxisParameters,
    Axis:= iq_stAxis.stMotionStage.Axis,
    Execute:= bExecParamRead );

// Copy axis parameters that we want to expose to the EPICS layer.
 iq_stAxis.stMotionStage.stAxisParametersExposed.bCtrlEnablePosDiffControl     :=  iq_stAxis.stMotionStage.stAxisParameters.bCtrlEnablePosDiffControl;
 iq_stAxis.stMotionStage.stAxisParametersExposed.bEncEnableSoftEndMaxControl   :=  iq_stAxis.stMotionStage.stAxisParameters.bEncEnableSoftEndMaxControl;
 iq_stAxis.stMotionStage.stAxisParametersExposed.bEncEnableSoftEndMinControl   :=  iq_stAxis.stMotionStage.stAxisParameters.bEncEnableSoftEndMinControl;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fAccelerationMax              :=  iq_stAxis.stMotionStage.stAxisParameters.fAccelerationMax;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fCtrlPosDiffMax               :=  iq_stAxis.stMotionStage.stAxisParameters.fCtrlPosDiffMax;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fCtrlPosDiffMaxTime           :=  iq_stAxis.stMotionStage.stAxisParameters.fCtrlPosDiffMaxTime;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fDecelerationMax              :=  iq_stAxis.stMotionStage.stAxisParameters.fDecelerationMax;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fEncSoftEndMax                :=  iq_stAxis.stMotionStage.stAxisParameters.fEncSoftEndMax;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fEncSoftEndMin                :=  iq_stAxis.stMotionStage.stAxisParameters.fEncSoftEndMin;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fVeloMaximum                  :=  iq_stAxis.stMotionStage.stAxisParameters.fVeloMaximum;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fEncOffset                       :=  iq_stAxis.stMotionStage.stAxisParameters.fEncOffset;
 iq_stAxis.stMotionStage.stAxisParametersExposed.fEncScaleFactorInternal       :=  iq_stAxis.stMotionStage.stAxisParameters.fEncScaleFactorInternal;

bExecParamRead R= fbMcReadParams.Done OR fbMcReadParams.Error;
 iq_stAxis.stMotionStage.bAxisParamsInit S= fbMcReadParams.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{a8134580-303c-4b2f-8942-be52670189d3}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iq_stAxis.stMotionStage	: REFERENCE TO ST_MotionStage;
    stMCS2ChanParameter : REFERENCE TO ST_MCS2ChanParameter;
    (*Mandatory must be unique for each MCS2 axis *)
    eModule : E_Module;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iq_stAxis.stMotionStage REF= iq_stAxis.stMotionStage;
THIS^.iq_stAxis.stChanParams REF= stMCS2ChanParameter;
THIS^.eModule := eModule;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Halt" Id="{6287ad75-ad53-4d78-9e75-75537e8950c5}">
      <Declaration><![CDATA[METHOD Halt
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMcHalt(
    Axis :=  iq_stAxis.stMotionStage.Axis,
    Execute := bHalt,
    Deceleration :=  iq_stAxis.stMotionStage.fDeceleration,
    BufferMode := MC_BufferMode.MC_Aborting,
);
IF fbMcHalt.Done THEN
    bHalt := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Interlock" Id="{b0516fc0-3ac5-4a37-a4b7-b21194f9b805}">
      <Declaration><![CDATA[METHOD PUBLIC Interlock

VAR_INST
    {attribute 'hide'}
    bPositiveDirection  : BOOL;
    {attribute 'hide'}
    bNegativeDirection  : BOOL;
    {attribute 'hide'}
    ftForwardEnabled    : F_TRIG;
    {attribute 'hide'}
    ftBackwardEnabled   : F_TRIG;
    {attribute 'hide'}
    bHitForwardLimit    : BOOL;
    {attribute 'hide'}
    bHitBackwardLimit   : BOOL;
    {attribute 'hide'}
    fCurrentPosition    : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Positive or Negative direction.
// In step mode fPosDiff is unreliable for direction: fPosition is the stale NC setpoint
// and fMeasuredPos is the live encoder, so their difference inverts as the motor moves.
// Use the step count sign instead, which is set explicitly at command issue time.
IF fbDriveManager.bStepModeEnabled THEN
    bPositiveDirection := iq_stAxis.stMotionStage.bBusy AND iq_stAxis.stChanParams.nChanStep > 0;
    bNegativeDirection := iq_stAxis.stMotionStage.bBusy AND iq_stAxis.stChanParams.nChanStep < 0;
ELSE
    bPositiveDirection := iq_stAxis.stMotionStage.bBusy AND iq_stAxis.stMotionStage.fPosDiff > 0;
    bNegativeDirection := iq_stAxis.stMotionStage.bBusy AND iq_stAxis.stMotionStage.fPosDiff < 0;
END_IF

// If the drive starts limited and no direction history is available, infer the
// blocked side from the nearest configured software range limit. The aggregate
// InternalLimitActive bit does not identify the side by itself.
fCurrentPosition := DINT_TO_LREAL(iq_stAxis.stMotionStage.nRawEncoderDINT)
                    * MAX(iq_stAxis.stMotionStage.stAxisParameters.fEncScaleFactorInternal,
                          iq_stAxis.stChanParams.fScalingFactor);
IF stDS402Drive.stDriveStatus.InternalLimitActive THEN
    IF NOT bLastPositiveDirection AND NOT bLastNegativeDirection THEN
        IF fbReadChanParams.bAllReadsComplete THEN
            IF iq_stAxis.stChanParams.nSoftLimMax > iq_stAxis.stChanParams.nSoftLimMin THEN
                IF ABS(fCurrentPosition - iq_stAxis.stChanParams.nSoftLimMin)
                   < ABS(iq_stAxis.stChanParams.nSoftLimMax - fCurrentPosition) THEN
                    bLastNegativeDirection := TRUE;
                ELSE
                    bLastPositiveDirection := TRUE;
                END_IF
            END_IF
        END_IF
    END_IF
END_IF

// Preserve the last commanded direction across the stop and PLC restart. The
// drive exposes one aggregate limit bit, so this retained context identifies
// which direction should remain blocked during recovery.
IF NOT stDS402Drive.stDriveStatus.InternalLimitActive
    OR (NOT bHitForwardLimit AND NOT bHitBackwardLimit) THEN
    IF bPositiveDirection THEN
        bLastPositiveDirection := TRUE;
        bLastNegativeDirection := FALSE;
    ELSIF bNegativeDirection THEN
        bLastPositiveDirection := FALSE;
        bLastNegativeDirection := TRUE;
    END_IF
END_IF

// Latch which physical limit was hit; clear once the drive is no longer reporting a limit.
// A single InternalLimitActive bit covers both directions, so direction at the time of
// the hit is used to determine which enable to hold off.
bHitForwardLimit  S= stDS402Drive.stDriveStatus.InternalLimitActive
                   AND (bPositiveDirection OR bLastPositiveDirection);
bHitBackwardLimit S= stDS402Drive.stDriveStatus.InternalLimitActive
                    AND (bNegativeDirection OR bLastNegativeDirection);
bHitForwardLimit  R= NOT stDS402Drive.stDriveStatus.InternalLimitActive;
bHitBackwardLimit R= NOT stDS402Drive.stDriveStatus.InternalLimitActive;

// An active limit with no known direction disables both directions. Once the
// hit direction is known, only that direction is disabled for reverse recovery.
iq_stAxis.stMotionStage.bLimitForwardEnable := NOT stDS402Drive.stDriveStatus.InternalLimitActive
                                     OR (bHitBackwardLimit AND NOT bHitForwardLimit);
iq_stAxis.stMotionStage.bLimitBackwardEnable := NOT stDS402Drive.stDriveStatus.InternalLimitActive
                                      OR (bHitForwardLimit AND NOT bHitBackwardLimit);

// use falling trigger to avoid spamming sErrorMessage
ftForwardEnabled(CLK := iq_stAxis.stMotionStage.bLimitForwardEnable);
ftBackwardEnabled(CLK := iq_stAxis.stMotionStage.bLimitBackwardEnable);

// A limit hit is the lowest priority message. Never post one over a latched fault,
// and retract our own once the drive releases the limit so a stale warning cannot
// later be promoted into sErrorMessage. The drive stops the positioner itself and
// SetEnables drops the offending direction, so no halt is requested here.
IF NOT iq_stAxis.stMotionStage.bError AND NOT fbhome.bHomeMoveBusy THEN
    IF bHitForwardLimit AND ftForwardEnabled.Q THEN
        iq_stAxis.stMotionStage.sCustomErrorMessage := sMsgPosLimit;
    ELSIF bHitBackwardLimit AND ftBackwardEnabled.Q THEN
        iq_stAxis.stMotionStage.sCustomErrorMessage := sMsgNegLimit;
    END_IF
END_IF

IF NOT bHitForwardLimit AND NOT bHitBackwardLimit
   AND (iq_stAxis.stMotionStage.sCustomErrorMessage = sMsgPosLimit
        OR iq_stAxis.stMotionStage.sCustomErrorMessage = sMsgNegLimit) THEN
    iq_stAxis.stMotionStage.sCustomErrorMessage := '';
END_IF

IF NOT  iq_stAxis.stMotionStage.bError AND  iq_stAxis.stMotionStage.bExecute AND NOT  iq_stAxis.stMotionStage.bUserEnable THEN
     iq_stAxis.stMotionStage.bError := TRUE;
     iq_stAxis.stMotionStage.nErrorId := 1;
     iq_stAxis.stMotionStage.sCustomErrorMessage := 'Move requested, but user enable is disabled!';
END_IF

// Update all enable booleans
SetEnables();]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveAbsolute" Id="{c9986ba7-a025-4f1a-8312-93dc4112a24c}">
      <Declaration><![CDATA[METHOD PUBLIC  MoveAbsolute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMcMoveAbsolute(
    Axis :=  iq_stAxis.stMotionStage.Axis,
    Execute := bExecMove AND fbMcPower.Status AND fbDriveManager.bCSPModeEnabled,
    Position :=  iq_stAxis.stMotionStage.fPosition,
    Velocity :=  iq_stAxis.stMotionStage.fVelocity,
    Acceleration :=  iq_stAxis.stMotionStage.fAcceleration,
    Deceleration :=  iq_stAxis.stMotionStage.fDeceleration,
    BufferMode := MC_BufferMode.MC_Aborting,
);

IF fbMcMoveAbsolute.Done (*OR fbMcReset.Done*) THEN
    (*Hold the position in close loop before dropping power, a positional drift will occur then*)
    IF ( iq_stAxis.stMotionStage.nEnableMode = E_StageEnableMode.DURING_MOTION ) THEN
        bPositionHold := TRUE;
        tonHoldTime.IN:=TRUE;
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="PersistParameters" Id="{827e19b0-eb90-45f1-a0f0-e397f2f834ae}">
      <Declaration><![CDATA[METHOD PersistParameters
VAR_INPUT
    Enable  : BOOL;
END_VAR

VAR_INST
    {attribute 'hide'}
    bEncError           : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Save Encoder position
// needs some pre-conditions to use persistent storage
IF Enable THEN
    // Check ST_MotionStage for an encoder error (range 0x44nn)
    bEncError:=  iq_stAxis.stMotionStage.Axis.Status.Error AND  (  iq_stAxis.stMotionStage.Axis.Status.ErrorID  >= 16#4400  AND  iq_stAxis.stMotionStage.Axis.Status.ErrorID <= 16#44FF );
    // Do not save if we're currently loading or if there is an encoder error
    IF NOT bRestoreLoad AND NOT bEncError AND NOT bRestoreWaitRetry THEN
        fSavedPosition :=  iq_stAxis.stMotionStage.Axis.NcToPlc.ActPos;
        // This persistent variable lets us check if anything was saved
        // It will be TRUE at startup if we have saved values
        bSaved := TRUE;
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="PostInit" Id="{7af64fe1-72e2-4a67-9fd4-3933db27c0b4}">
      <Declaration><![CDATA[{attribute 'call_after_init'}
(*  eModule: Mandatory must be unique for each MCS2 axis
    clears startup errors or warnings. the process is completed at run time
    SDO update of Drive and open Loop parameter Indexes based on module number
*)
METHOD PostInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* SDO update of Drive and open Loop parameter Indexes based on module number *)
iq_stAxis.stChanParams.nChanErrorCodeIdx        	:= nChanErrorCodeBase         	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanFErrWinIdx          	:= nChanFErrWinBase           	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanSoftLimitIdx        	:= nChanSoftLimitBase     		+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanHomeOffsIdx         	:= nChanHomeOffsetBase        	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanHomeMethodIdx         := nChanHomeMethodBase       	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanHomeVeloIdx         	:= nChanHomingSpeedBase       	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanhomeAccIdx          	:= nChanhomingAccBase         	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanStepIdx             	:= nChanOlStepBase            	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanStepFreqIdx         	:= nChanOlStepFreqBase        	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanStepAmpIdx          	:= nChanOlStepAmpBase         	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanMaxCloseLoopFreqIdx   := nChanMaxCloseLoopFreqBase  	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanPositionerTypeIdx     := nChanPositionerTypeBase    	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanCalibrationOptIdx     := nCHanCalibrationOptBase    	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanSensorPowerModeIdx    := nChanSensorPowerModeBase   	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanReferencingOptIdx     := nChanReferencingOptBase    	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanReferenceTypeIdx      := nChanReferenceTypeBase     	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanSafeDirIdx            := nChanSafeDirBase           	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanMotorLoadIdx          := nChanMotorLoadBase         	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChannelTypeIdx          	:= nChannelTypeBase       		+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanStateIdx         		:= nChannelStateBase      		+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanLogicalScaleOfsIdx   	:= nChanLogicalScaleOffsetBase	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanLogicalScaleInvIdx    := nChanLogicalScaleInvBase   	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanChannelTempIdx        := nChanChannelTempBase       	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanMovementTypeIdx       := nChanMovementTypeBase      	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanBaseUnitIdx           := nChanBaseUnitBase          	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanBaseResolutionIdx     := nChanBaseResolutionBase    	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanDistCodeInvIdx        := nChanDistCodeInvBase       	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanPositionerCtrlOptIdx  := nChanPositionerCtrlOptBase 	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanActuatorModeIdx       := nChanActuatorModeBase      	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanMotorLoadProtIdx      := nChanMotorLoadProtBase     	+ ((eModule-1) * nChanOfsBase);
iq_stAxis.stChanParams.nChanDiagClfIdx            := nChanDiagClfBase           	+ ((eModule-1) * nChanOfsBase);
bSystemInit := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PostMoveChecks" Id="{20c015e9-bf00-4308-96ac-d493b364e91d}">
      <Declaration><![CDATA[METHOD PRIVATE PostMoveChecks : BOOL
VAR_INST
    rtAbortedHome        : R_TRIG;
    rtAbortedStepMove    : R_TRIG;
    rtAbortedCalibration : R_TRIG;
    rtResetDone          : R_TRIG;
    rtHaltDone           : R_TRIG;
    rtMoveDone           : R_TRIG;
    rtHomeDone           : R_TRIG;
    rtStepMoveDone       : R_TRIG;
    rtCalibrationDone    : R_TRIG;
    ftEnableFallEdge     : F_TRIG;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rtAbortedHome(CLK := fbhome.bHomeMoveAborted);
rtAbortedStepMove(CLK := fbStepMode.bStepMoveAborted);
rtAbortedCalibration(CLK := fbCalibrate.bCalibrateMoveAborted);

rtResetDone(CLK := fbMcReset.Done);
rtHaltDone(CLK := fbMcHalt.Done);

rtMoveDone(CLK := fbMcMoveAbsolute.Done);
rtHomeDone(CLK := fbhome.bHomeMoveDone);
rtStepMoveDone(CLK := fbStepMode.bStepMoveDone);
rtCalibrationDone(CLK := fbCalibrate.bCalibrateMoveDone);

IF rtAbortedHome.Q OR rtAbortedStepMove.Q OR rtAbortedCalibration.Q
   OR rtResetDone.Q OR rtHaltDone.Q
   OR rtMoveDone.Q OR rtHomeDone.Q OR rtStepMoveDone.Q OR rtCalibrationDone.Q THEN

    IF NOT iq_stAxis.stMotionStage.bDone THEN
        iq_stAxis.stMotionStage.bExecute := FALSE;;
        iq_stAxis.stMotionStage.bHomed := fbhome.bHomeMoveDone;
        IF rtMoveDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.MoveDone;
        ELSIF rtStepMoveDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.StepMoveDone;
        ELSIF rtHomeDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.HomeDone;
            // Homing runs in DS402 manual HOME mode. Request closed-loop so the
            // drive manager switches the drive back to CSP now that homing is done.
            iq_stAxis.stChanParams.eOpModeReq := E_MCS2OpModeReq.CLOSED_LOOP;
        ELSIF rtCalibrationDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.CalibrationDone;
            // Calibration runs in DS402 manual CALIBRATE mode. Request closed-loop so
            // the drive manager switches the drive back to CSP now that calibration is done.
            iq_stAxis.stChanParams.eOpModeReq := E_MCS2OpModeReq.CLOSED_LOOP;
        ELSIF rtResetDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.ResetDone;
        ELSIF rtHaltDone.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.HaltDone;
        ELSIF rtAbortedHome.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.AbortedHome;
        ELSIF rtAbortedStepMove.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.AbortedStepMove;
        ELSIF rtAbortedCalibration.Q THEN
            iq_stAxis.stMotionStage.bDone := TRUE;
            eDoneCause := E_MoveDoneCause.AbortedCalibration;
        END_IF
        IF rtHomeDone.Q OR rtAbortedHome.Q OR rtCalibrationDone.Q OR rtAbortedCalibration.Q THEN
            bEnPosLag       := bRecentEnPosLagStatus;
            fParameterValue := BOOL_TO_LREAL(bRecentEnPosLagStatus);
        END_IF
        IF fbDriveManager.bDS402Manual
           AND NOT (rtHomeDone.Q OR rtAbortedHome.Q OR rtCalibrationDone.Q OR rtAbortedCalibration.Q) THEN
            bEnPosLag := FALSE;
        END_IF
        IF (iq_stAxis.stMotionStage.nEnableMode = E_StageEnableMode.DURING_MOTION) THEN
            bPositionHold := TRUE;
            tonHoldTime.IN := TRUE;
        END_IF
        // get stable current position storage
        iq_stAxis.stChanParams.fPosition := iq_stAxis.stMotionStage.fPosition;
    END_IF
END_IF

tonHoldTime(PT := UDINT_TO_TIME(iq_stAxis.stChanParams.nHoldTime));
IF tonHoldTime.Q THEN
    bPositionHold := FALSE;
    tonHoldTime.IN := FALSE;
    bLastHoltTimeOut := TRUE;
END_IF

(* updated axis status
   Not needed in manual mode *)
IF NOT fbDriveManager.bDS402Manual THEN
     iq_stAxis.stMotionStage.Axis.ReadStatus();
END_IF

bPrepareDisable S= (iq_stAxis.stMotionStage.nEnableMode = E_StageEnableMode.DURING_MOTION) AND ftExec.Q;

IF bPrepareDisable AND fbDriveManager.bCSPModeEnabled THEN
    IF iq_stAxis.stMotionStage.Axis.Status.StandStill THEN
        IF NOT bPositionHold THEN
            bPrepareDisable := FALSE;
            iq_stAxis.stMotionStage.bEnable := FALSE; // TwinCAT NC disables MC_Power (CSP)
        END_IF
    END_IF
ELSIF bPrepareDisable AND fbDriveManager.bDS402Manual THEN
    IF fbDriveManager.bOperational THEN
        IF NOT bPositionHold THEN
            bPrepareDisable := FALSE;
            iq_stAxis.stMotionStage.bEnable := FALSE; // Manual disables via drive control word
        END_IF
    END_IF
END_IF

ftEnableFallEdge(CLK := iq_stAxis.stMotionStage.bEnable);
IF ftEnableFallEdge.Q THEN
    // Only power off in manual if we're staying in manual. During a switch back
    // to CSP, let the NC ramp the control word down so it isn't disabled under it.
    IF fbDriveManager.bDS402Manual
       AND iq_stAxis.stChanParams.eOpModeReq <> E_MCS2OpModeReq.CLOSED_LOOP THEN
        stDS402Drive.nDriveControl := 6; // Manual mode power off
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Power" Id="{f641a677-a472-4a34-a0e0-f26f3662273e}">
      <Declaration><![CDATA[METHOD Power
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMcPower(
    Axis :=  iq_stAxis.stMotionStage.Axis,
    Enable :=  iq_stAxis.stMotionStage.bAllEnable,
    Enable_Positive :=  iq_stAxis.stMotionStage.bAllForwardEnable AND iq_stAxis.stChanParams.bOverrideDirEnable,
    Enable_Negative :=  iq_stAxis.stMotionStage.bAllBackwardEnable AND iq_stAxis.stChanParams.bOverrideDirEnable,
    Override := 100.0,
    BufferMode := MC_BufferMode.MC_Aborting
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{643b4736-0a43-4a18-8f6b-8a2439ed5e6f}">
      <Declaration><![CDATA[METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMcReset(
    Axis :=  iq_stAxis.stMotionStage.Axis,
    Execute := bReset
);
IF fbMcReset.Done THEN
    bReset := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RestoreMotionParams" Id="{8335d215-fac8-43bf-97f2-e08acc164700}">
      <Declaration><![CDATA[METHOD RestoreMotionParams
VAR_INPUT
    Enable  : BOOL;
END_VAR

VAR_INST
    fbSetPos            : MC_SetPosition;
    {attribute 'hide'}
    bLoad               : BOOL;
    {attribute 'hide'}
    bRestoreInit        : BOOL;
    {attribute 'hide'}
    nMaxRetries         : UINT := 10;
    {attribute 'hide'}
    nCurrTries          : UINT := 0;
    {attribute 'hide'}
    nLatchError         : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    // Trigger a load if anything was saved at all
    IF NOT bRestoreInit THEN
        bRestoreInit := TRUE;
        bRestoreLoad S= bSaved;
        fbSetPos.Options.ClearPositionLag := TRUE;
    END_IF

    // Set our position if bRestoreLoad is true
    fbSetPos( Axis:= iq_stAxis.stMotionStage.Axis, Execute:=bRestoreLoad, Position:=fSavedPosition);

    IF fbSetPos.Error THEN
        // Keep the error latched, it can disappear if Execute is set to FALSE
        nLatchError := fbSetPos.ErrorID;
        nCurrTries := nCurrTries + 1;
        IF nCurrTries >= nMaxRetries THEN
        // Alert the user that something has gone wrong
         iq_stAxis.stMotionStage.bError := TRUE;
         iq_stAxis.stMotionStage.nErrorId := nLatchError;
         iq_stAxis.stMotionStage.sCustomErrorMessage := 'Error loading previously saved position.';
        ELSE
            // Reset the FB for the next retry
            fbSetPos( Axis:= iq_stAxis.stMotionStage.Axis, Execute:=bRestoreLoad, Position:=fSavedPosition);
            // Try again
            bRestoreWaitRetry := TRUE;
        END_IF
    ELSIF fbSetPos.Done THEN
         iq_stAxis.stMotionStage.fPosition := fSavedPosition;
         iq_stAxis.stMotionStage.bRestoreDone := TRUE;
    END_IF

    // Only load once, at startup
    bRestoreLoad R= fbSetPos.Done OR fbSetPos.Error;

    tonRestoreRetry( IN := bRestoreWaitRetry, PT := T#100MS);
    bRestoreLoad S= tonRestoreRetry.Q;
    bRestoreWaitRetry R= tonRestoreRetry.Q;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ScaleEncRawValue" Id="{769f98a6-388a-461f-854a-93b1758d578f}">
      <Declaration><![CDATA[METHOD ScaleEncRawValue
VAR_INPUT
  //  bEnable: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* SmartACT: The encoder count from the Piezo drive is not a raw count from the embeded actuator device
   we get a calibrated nm value. thus the use of abs() since this value is signed.*)

iq_stAxis.stMotionStage.nEncoderCount:=DINT_TO_UDINT(ABS( iq_stAxis.stMotionStage.nRawEncoderDINT));

// calibrated encoder readback
IF NOT fbDriveManager.bStepModeEnabled THEN
    // Close loop NC
    fMeasuredPos:= iq_stAxis.stMotionStage.Axis.NcToPlc.ActPos;
    fMeasuredVelo := iq_stAxis.stMotionStage.Axis.NcToPlc.ActVelo;
    fMeasuredAcc :=  iq_stAxis.stMotionStage.Axis.NcToPlc.ActAcc;
    iq_stAxis.stMotionStage.fPosDiff:= iq_stAxis.stMotionStage.Axis.NcToPlc.PosDiff;
ELSE
    fMeasuredPos:=DINT_TO_REAL( iq_stAxis.stMotionStage.nRawEncoderDINT) * MAX( iq_stAxis.stMotionStage.stAxisParameters.fEncScaleFactorInternal, iq_stAxis.stChanParams.fScalingFactor);
    iq_stAxis.stMotionStage.fPosDiff:= iq_stAxis.stMotionStage.fPosition - fMeasuredPos;
    // NB: Not actual in open loop
    fMeasuredVelo := iq_stAxis.stMotionStage.fVelocity;
    fMeasuredAcc :=  iq_stAxis.stMotionStage.fAcceleration;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEnables" Id="{28f7e94e-bad4-40ca-b34a-f8da453343cc}">
      <Declaration><![CDATA[METHOD SetEnables
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ iq_stAxis.stMotionStage.bAllForwardEnable:= iq_stAxis.stMotionStage.bLimitForwardEnable
                                    AND ( iq_stAxis.stMotionStage.bGantryForwardEnable OR NOT  iq_stAxis.stMotionStage.bGantryAxis)
                                    AND  iq_stAxis.stMotionStage.stEPSForwardEnable.bEPS_OK
                                    AND  iq_stAxis.stChanParams.bOverrideDirEnable;
 iq_stAxis.stMotionStage.bAllBackwardEnable:= iq_stAxis.stMotionStage.bLimitBackwardEnable
                                    AND ( iq_stAxis.stMotionStage.bGantryBackwardEnable OR NOT  iq_stAxis.stMotionStage.bGantryAxis)
                                    AND  iq_stAxis.stMotionStage.stEPSBackwardEnable.bEPS_OK
                                    AND  iq_stAxis.stChanParams.bOverrideDirEnable;

 iq_stAxis.stMotionStage.bAllEnable:= iq_stAxis.stMotionStage.bEnable
                            AND  iq_stAxis.stMotionStage.bHardwareEnable
                            AND  iq_stAxis.stMotionStage.stEPSPowerEnable.bEPS_OK;
 iq_stAxis.stMotionStage.bAllEnable R= NOT  iq_stAxis.stMotionStage.bUserEnable;]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateEpicsStatus" Id="{dc90c8f8-9d88-4ab9-9dc0-f90cd21b81fc}">
      <Declaration><![CDATA[METHOD UpdateEpicsStatus
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//////////////////////////////////////////////////////////////////
// Transfer NC parameter status to EPICS
//////////////////////////////////////////////////////////////////
 iq_stAxis.stMotionStage.nMotionAxisID :=  iq_stAxis.stMotionStage.Axis.NcToPlc.AxisId;
 iq_stAxis.stMotionStage.stAxisStatus.bEnable:= iq_stAxis.stMotionStage.bAllEnable;
 iq_stAxis.stMotionStage.stAxisStatus.bEnabled:= iq_stAxis.stMotionStage.bEnableDone; // account for PowerEnable from power block
 iq_stAxis.stMotionStage.stAxisStatus.bError:= iq_stAxis.stMotionStage.bError;
 iq_stAxis.stMotionStage.stAxisStatus.bHomeSensor:= iq_stAxis.stMotionStage.bHome;
 iq_stAxis.stMotionStage.stAxisStatus.bLimitBwd:= iq_stAxis.stMotionStage.bAllBackwardEnable;
 iq_stAxis.stMotionStage.stAxisStatus.bLimitFwd:= iq_stAxis.stMotionStage.bAllForwardEnable;
 iq_stAxis.stMotionStage.stAxisStatus.bReset:= iq_stAxis.stMotionStage.bReset;
 iq_stAxis.stMotionStage.stAxisStatus.fAcceleration:=fMeasuredAcc;
 iq_stAxis.stMotionStage.stAxisStatus.fActDiff:= iq_stAxis.stMotionStage.fPosDiff;
 iq_stAxis.stMotionStage.stAxisStatus.fActPosition:=fMeasuredPos;
 iq_stAxis.stMotionStage.stAxisStatus.fActVelocity:=fMeasuredVelo;
 iq_stAxis.stMotionStage.stAxisStatus.fDeceleration:=fMeasuredAcc;
 iq_stAxis.stMotionStage.stAxisStatus.fOverride:=fbMcPower.Override;
 iq_stAxis.stMotionStage.stAxisStatus.fPosition:= iq_stAxis.stMotionStage.fPosition;
 iq_stAxis.stMotionStage.stAxisStatus.fVelocity:= iq_stAxis.stMotionStage.fVelocity;
 iq_stAxis.stMotionStage.stAxisStatus.nCmdData:=INT_TO_UINT( iq_stAxis.stMotionStage.nCmdData);  //Or nCmdDataLocal
 iq_stAxis.stMotionStage.stAxisStatus.nCommand:=INT_TO_UINT( iq_stAxis.stMotionStage.nCommand);  //Or nCommandLocal
 iq_stAxis.stMotionStage.stAxisStatus.nErrorId:= iq_stAxis.stMotionStage.nErrorId;
 iq_stAxis.stMotionStage.stAxisStatus.bBusy:= iq_stAxis.stMotionStage.bBusy;
 iq_stAxis.stMotionStage.stAxisStatus.bHomed:= iq_stAxis.stMotionStage.bHomed;
 iq_stAxis.stMotionStage.stAxisStatus.bExecute:=bLocalExec;
 iq_stAxis.stMotionStage.stAxisStatus.nCommand:=3; // If this is not 3, the IOC stops updating positions during homing


]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteParameterNC" Id="{a04e1bd8-55ae-495c-bca4-be27f11603b4}">
      <Declaration><![CDATA[METHOD WriteParameterNC
VAR_INPUT
    Execute:BOOL;
    ParameterNumber : MC_AxisParameter;
    ParameterValue  : LREAL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*Do not change a moving axis parameter*)
fbMcWriteParameter(
    Axis:=iq_stAxis.stMotionStage.Axis,
    Execute:=(Execute AND iq_stAxis.stMotionStage.Axis.Status.NotMoving),
    ParameterNumber:=ParameterNumber,
    Value:=ParameterValue
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>