<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MCS2StepMode_Test" Id="{7c4c1f52-9a1b-4f7e-9d63-2b8f4c0a5e11}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Unit tests for FB_MCS2StepMode execute semantics.

    The block takes a level-held execute: the rising edge starts one step, the
    step runs while bExecute stays TRUE, and the falling edge stops the step and
    reports the move as aborted instead of leaving the drive commanded. The
    latched results survive a dropped execute, and a latched fault is only
    cleared through Reset().

    The block advances at most one state per call, so each test walks several
    PLC cycles with nStep before it asserts.
*)
FUNCTION_BLOCK FB_MCS2StepMode_Test EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestRisingAndFallingEdge();
TestRisingEdgeRestartsAfterAbort();
TestExecuteDropKeepsLatchedFault();
]]></ST>
    </Implementation>
    <Method Name="TestRisingAndFallingEdge" Id="{7c4c1f52-9a1b-4f7e-9d63-2b8f4c0a5e21}">
      <Declaration><![CDATA[METHOD PRIVATE TestRisingAndFallingEdge
VAR_INST
    fbSut : FB_MCS2StepMode;
    stMotionStage : ST_MotionStage;
    stDrive : ST_DS402Drive;
    nStep : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestRisingAndFallingEdge');

CASE nStep OF
    0:
        // No execute: nothing is commanded.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IDLING, 'Block should idle while execute is FALSE');
        AssertFalse(fbSut.bStepMoveBusy, 'Block should not be busy while execute is FALSE');
        AssertFalse(stDrive.nDriveControl.3, 'Enable operation (bit 3) must stay FALSE before the rising edge');
        AssertFalse(stDrive.nDriveControl.4, 'Step trigger (bit 4) must stay FALSE before the rising edge');
        nStep := 1;

    1:
        // Rising edge: the step request is accepted.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.bStepMoveBusy, 'Rising edge should start the step and set busy');
        AssertFalse(fbSut.bStepMoveDone, 'Done must not be set by a fresh start');
        AssertFalse(fbSut.bStepMoveAborted, 'Aborted must be cleared by a fresh start');
        AssertTrue(fbSut.eStepState = E_MoveState.INIT, 'Rising edge should enter INIT');
        AssertTrue(stDrive.nDriveControl.3, 'Enable operation (bit 3) should be set on the rising edge');
        nStep := 2;

    2:
        // Execute still held: INIT triggers the step and starts the settling time.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IN_PROGRESS, 'INIT should advance to IN_PROGRESS while execute is held');
        AssertTrue(stDrive.nDriveControl.4, 'Step trigger (bit 4) should be set in IN_PROGRESS');
        nStep := 3;

    3:
        // Execute still held, target not reached: the step keeps running.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IN_PROGRESS, 'Held execute must not abort the step');
        AssertTrue(fbSut.bStepMoveBusy, 'Held execute must keep the move busy');
        AssertFalse(fbSut.bStepMoveAborted, 'No abort may be reported while execute is held');
        nStep := 4;

    4:
        // Falling edge: the step is stopped instead of being left running.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.INTERRUPTED, 'Falling edge should interrupt the step');
        AssertTrue(fbSut.bStepMoveAborted, 'Falling edge should report the move aborted');
        nStep := 5;

    5:
        // INTERRUPTED releases the drive command and the busy flag.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertFalse(stDrive.nDriveControl.4, 'Step trigger (bit 4) must be released after the abort');
        AssertFalse(fbSut.bStepMoveBusy, 'Busy must be released after the abort');
        AssertTrue(fbSut.bStepMoveAborted, 'Aborted must stay latched until the next rising edge');
        AssertTrue(fbSut.eStepState = E_MoveState.IDLING, 'Block should return to IDLING after the abort');
        nStep := 6;
        TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestRisingEdgeRestartsAfterAbort" Id="{7c4c1f52-9a1b-4f7e-9d63-2b8f4c0a5e22}">
      <Declaration><![CDATA[METHOD PRIVATE TestRisingEdgeRestartsAfterAbort
VAR_INST
    fbSut : FB_MCS2StepMode;
    stMotionStage : ST_MotionStage;
    stDrive : ST_DS402Drive;
    nStep : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestRisingEdgeRestartsAfterAbort');

CASE nStep OF
    0:
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        nStep := 1;

    1:
        // First rising edge starts a step.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.bStepMoveBusy, 'Rising edge should start the first step');
        nStep := 2;

    2:
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IN_PROGRESS, 'First step should reach IN_PROGRESS');
        nStep := 3;

    3:
        // Falling edge aborts the first step.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.bStepMoveAborted, 'Falling edge should abort the first step');
        nStep := 4;

    4:
        // Back to idle, the abort result is still latched.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IDLING, 'Block should return to IDLING');
        AssertTrue(fbSut.bStepMoveAborted, 'Aborted must stay latched without a new rising edge');
        nStep := 5;

    5:
        // A new rising edge starts the next step and clears the old result.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.bStepMoveBusy, 'A new rising edge should start the next step');
        AssertFalse(fbSut.bStepMoveAborted, 'A new rising edge should clear the latched abort');
        AssertTrue(fbSut.eStepState = E_MoveState.INIT, 'A new rising edge should enter INIT');
        nStep := 6;

    6:
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IN_PROGRESS, 'Restarted step should reach IN_PROGRESS');
        nStep := 7;
        TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestExecuteDropKeepsLatchedFault" Id="{7c4c1f52-9a1b-4f7e-9d63-2b8f4c0a5e23}">
      <Declaration><![CDATA[METHOD PRIVATE TestExecuteDropKeepsLatchedFault
VAR_INST
    fbSut : FB_MCS2StepMode;
    stMotionStage : ST_MotionStage;
    stDrive : ST_DS402Drive;
    nStep : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestExecuteDropKeepsLatchedFault');

CASE nStep OF
    0:
        // Stage already faulted, no execute: nothing starts.
        stMotionStage.bError := TRUE;
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.IDLING, 'Block should idle while execute is FALSE');
        nStep := 1;

    1:
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.INIT, 'Rising edge should enter INIT');
        nStep := 2;

    2:
        // The fault seen in INIT puts the block into ERROR.
        fbSut(bExecute := TRUE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.ERROR, 'A faulted stage should put the block into ERROR');
        AssertFalse(fbSut.bStepMoveBusy, 'ERROR should release busy');
        nStep := 3;

    3:
        // Dropping execute must not dismiss the latched fault or the error state.
        fbSut(bExecute := FALSE, stDS402Drive := stDrive, stMotionStage := stMotionStage);
        AssertTrue(fbSut.eStepState = E_MoveState.ERROR, 'Dropping execute must not leave the ERROR state');
        AssertTrue(stMotionStage.bError, 'Dropping execute must not clear the stage fault');
        nStep := 4;
        TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
