<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionStageSetAndMoveHelper" Id="{d7e042f5-46bb-44d9-bf49-77a017ae9e25}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionStageSetAndMoveHelper
(*
    Test helper: reset an stMotionStage, set it to a start position, then move it to a goal position.

    Usage: hold bExecute TRUE and poll the outputs. The request starts on the rising edge of
    bExecute and stops on the falling edge, which aborts the position set, clears the move
    command and deactivates the axis. The result outputs (bResetDone, bSetDone, bMotionStarted,
    bMoveDone and bError) are latched: they hold their result until the next rising edge of
    bExecute or a call to Reset(), so a completed or failed step cannot silently disappear
    while bExecute is held.

    The motion stage must have its own FB_MotionStage running outside of this block.

    History:
    - 2026-11-27: handle the falling edge of bExecute (stop motion) and latch the result
      outputs, per convention conv_4131eec9c934.
*)
VAR_INPUT
    // Start the request on the rising edge, stop the motion on the falling edge.
    bExecute: BOOL;
    // The position to set the motor to
    fStartPosition: LREAL;
    // The goal to move the motor towards
    fGoalPosition: LREAL;
    // The velocity to move at
    fVelocity: LREAL;
    // The allowable deviation from the goal position to be considered done moving.
    fDelta: LREAL;
END_VAR
VAR_IN_OUT
    // The motion stage to operate on
    stMotionStage: ST_MotionStage;
END_VAR
VAR_OUTPUT
    // Latched TRUE once the motor has no errors and is deactivated. Cleared by the next rising edge of bExecute or by Reset().
    bResetDone: BOOL;
    // Latched TRUE once the set position completes. Cleared by the next rising edge of bExecute or by Reset().
    bSetDone: BOOL;
    // Latched TRUE once the motor begins moving. Cleared by the next rising edge of bExecute or by Reset().
    bMotionStarted: BOOL;
    // Latched TRUE once the motor reaches its destination. Cleared by the next rising edge of bExecute or by Reset().
    bMoveDone: BOOL;
    // Latched TRUE if the stage reports an error while a request is active. Cleared by the next rising edge of bExecute or by Reset().
    bError: BOOL;
END_VAR
VAR
    // Rising edge of bExecute: start a new request and clear the latched results
    rtExec: R_TRIG;
    // Falling edge of bExecute: stop the motion and abort the request
    ftExec: F_TRIG;
    // Sets the motor to the start position before the move
    mcSetPos: MC_SetPosition;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Evaluate the command edges
rtExec(CLK:=bExecute);
ftExec(CLK:=bExecute);

// Rising edge of bExecute: start a new request and clear the latched results of the previous one
IF rtExec.Q THEN
    stMotionStage.bMoveCmd := FALSE;
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
    bResetDone := FALSE;
    bSetDone := FALSE;
    bMotionStarted := FALSE;
    bMoveDone := FALSE;
    bError := FALSE;
END_IF

// Falling edge of bExecute: stop the motion and abort the request. The latched results are
// left as-is, so a step that finished (or failed) stays visible until it is acknowledged.
IF ftExec.Q THEN
    stMotionStage.bMoveCmd := FALSE;
    stMotionStage.bExecute := FALSE;
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
END_IF

// Nothing else to do while the request is inactive: the latched outputs are held
IF NOT bExecute THEN
    RETURN;
END_IF

// Latch the reset result: the motor must be free of errors and deactivated
bResetDone S= NOT stMotionStage.bError AND NOT stMotionStage.bBusy;

// Latch a stage error for the caller to inspect
IF bResetDone THEN
    bError S= stMotionStage.bError;
END_IF

// Latch the arrival: the move is done once we are within fDelta of the goal
bMoveDone S= stMotionStage.Axis.NcToPlc.ActPos <= fGoalPosition + fDelta AND
             stMotionStage.Axis.NcToPlc.ActPos >= fGoalPosition - fDelta;

// Set the start position before the move
IF NOT bSetDone THEN
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    IF stMotionStage.stAxisStatus.fActPosition <> fStartPosition THEN
        mcSetPos(
            Axis:=stMotionStage.Axis,
            Execute:=NOT mcSetPos.Execute,
            Position:=fStartPosition,
            Mode:=FALSE,
            Done=>
        );
        // Latch a failure of the position set for the caller to inspect
        bError S= mcSetPos.Error;
    ELSE
        bSetDone := TRUE;
    END_IF
ELSIF NOT bMoveDone THEN
    // Command the move to the goal
    stMotionStage.bEnable := TRUE;
    IF NOT bMotionStarted AND NOT stMotionStage.Axis.Status.Disabled THEN
        stMotionStage.fPosition := fGoalPosition;
        stMotionStage.fVelocity := fVelocity;
        stMotionStage.bMoveCmd := TRUE;
        bMotionStarted := TRUE;
    END_IF
END_IF

// Once the move is done, deactivate the motor
IF bMoveDone THEN
    stMotionStage.bReset := TRUE;
END_IF
]]></ST>
    </Implementation>
    <Method Name="Reset" Id="{099bbc37-1b9e-476a-b5a9-5f8f1f38a75e}">
      <Declaration><![CDATA[
METHOD PUBLIC Reset
(*
    Return the helper to its initial state: forget the pending execute edges, deactivate
    the motor and clear all latched outputs.
*)
VAR_IN_OUT
    stMotionStage : ST_MotionStage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
rtExec(CLK:=FALSE);
ftExec(CLK:=FALSE);

stMotionStage.bReset := FALSE;
stMotionStage.bEnable := FALSE;
stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
mcSetPos(
    Axis:=stMotionStage.Axis,
    Execute:=FALSE
);
bResetDone := FALSE;
bSetDone := FALSE;
bMotionStarted := FALSE;
bMoveDone := FALSE;
bError := FALSE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>