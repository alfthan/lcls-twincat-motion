<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionStageSetAndMoveHelper" Id="{d7e042f5-46bb-44d9-bf49-77a017ae9e25}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionStageSetAndMoveHelper
(*
    Set an stMotionStage to a start position, then command a move towards a goal
    position. Intended for use inside unit tests.

    On the rising edge of bExecute the stage is reset, disabled and set to
    fStartPosition with MC_SetPosition. Once the start position is set, the stage
    is enabled and commanded towards fGoalPosition at fVelocity.

    Setpoint validation: before fStartPosition, fGoalPosition or fVelocity can
    reach MC_SetPosition or the ST_MotionStage command interface they are checked
    against the limits that FB_MotionStageNCParams reads back from the axis into
    stMotionStage.stAxisParameters - the static soft end minimum and maximum for
    positions and fVeloMaximum for the velocity - and against the largest setpoint
    magnitude this block accepts, so that NaN and infinite requests are refused.
    An out-of-range request is rejected rather than clamped: the stage is held
    idle, no setpoint is commanded, and the rejection is latched in
    bError/nErrorId/sErrorMessage until bExecute rises again or Reset() is called.
    The axis limits are only enforced once the axis parameters have been read back
    (stMotionStage.bAxisParamsInit); until then there is no configured limit to
    check against.

    The motion stage should have its own FB_MotionStage or some stand-in for it
    running outside of the FB.

    This is, in itself, tested in FB_MotionStageSetAndMoveHelper_Test.

    History:
    - 2026-11-28 (agent): header comment, and reject setpoints that are outside of
      the configured axis limits before they are commanded to hardware.
*)
VAR_INPUT
    // Begin on rising edge, stop on falling edge.
    bExecute: BOOL;
    // The position to set the motor to, in engineering units
    fStartPosition: LREAL;
    // The goal to move the motor towards, in engineering units
    fGoalPosition: LREAL;
    // The velocity to move at, in engineering units per second
    fVelocity: LREAL;
    // The allowable deviation from the goal position to be considered done moving, in engineering units.
    fDelta: LREAL;
END_VAR
VAR_IN_OUT
    stMotionStage: ST_MotionStage;
END_VAR
VAR_OUTPUT
    // Goes to TRUE once the motor has no errors and is deactivated.
    bResetDone: BOOL;
    // Goes to TRUE once the set position completes.
    bSetDone: BOOL;
    // Goes to TRUE once the motor begins moving.
    bMotionStarted: BOOL;
    // Goes to TRUE once the motor reaches its destination.
    bMoveDone: BOOL;
    // Goes to TRUE if a requested setpoint was rejected for being outside of the axis limits.
    // Latched until the next rising edge of bExecute or a call to Reset().
    bError: BOOL;
    // The error code of the rejection, or 0 if there is no error.
    nErrorId: UDINT;
    // A description of the rejection, suitable for a test assert message.
    sErrorMessage: STRING;
END_VAR
VAR
    rtExec: R_TRIG;
    mcSetPos: MC_SetPosition;
    // Lowest position the axis may be commanded to, from the axis soft limits
    fPosMin: LREAL;
    // Highest position the axis may be commanded to, from the axis soft limits
    fPosMax: LREAL;
    // Highest velocity the axis may be commanded to, from the axis maximum velocity
    fVelMax: LREAL;
    // TRUE if the requested setpoints are outside of the configured limits
    bInvalidRequest: BOOL;
    // Why the most recent request was rejected
    sRejectReason: STRING;
END_VAR
VAR CONSTANT
    // Largest magnitude this block accepts for a setpoint. Used in place of a
    // configured limit when the axis has none, so that NaN and infinite requests
    // are still rejected. Well beyond the span of any real axis.
    MAX_SETPOINT_MAGNITUDE: LREAL := 1.0E38;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rtExec(CLK:=bExecute);

IF rtExec.Q THEN
    // New request: acknowledge any latched rejection and start from a known state
    bError := FALSE;
    nErrorId := 0;
    sErrorMessage := '';
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
    bResetDone := FALSE;
    bSetDone := FALSE;
    bMotionStarted := FALSE;
    bMoveDone := FALSE;
END_IF

// Range check the requested setpoints against the configured axis limits.
// The limits are the ones FB_MotionStageNCParams reads back from the axis; until
// that read has succeeded there is no configured limit, so only the overall
// magnitude limit applies. The comparisons are written as "not inside the range"
// so that a NaN, which compares FALSE against every bound, is rejected as well.
IF stMotionStage.bAxisParamsInit AND
   stMotionStage.stAxisParameters.fEncSoftEndMax > stMotionStage.stAxisParameters.fEncSoftEndMin THEN
    fPosMin := stMotionStage.stAxisParameters.fEncSoftEndMin;
    fPosMax := stMotionStage.stAxisParameters.fEncSoftEndMax;
ELSE
    fPosMin := -MAX_SETPOINT_MAGNITUDE;
    fPosMax := MAX_SETPOINT_MAGNITUDE;
END_IF
IF stMotionStage.bAxisParamsInit AND stMotionStage.stAxisParameters.fVeloMaximum > 0.0 THEN
    fVelMax := stMotionStage.stAxisParameters.fVeloMaximum;
ELSE
    fVelMax := MAX_SETPOINT_MAGNITUDE;
END_IF

bInvalidRequest := FALSE;
sRejectReason := '';
IF NOT (fStartPosition >= fPosMin AND fStartPosition <= fPosMax) THEN
    bInvalidRequest := TRUE;
    sRejectReason := 'Rejected start position outside of the axis limits';
END_IF
IF NOT (fGoalPosition >= fPosMin AND fGoalPosition <= fPosMax) THEN
    bInvalidRequest := TRUE;
    sRejectReason := 'Rejected goal position outside of the axis limits';
END_IF
IF NOT (fVelocity > 0.0 AND fVelocity <= fVelMax) THEN
    bInvalidRequest := TRUE;
    sRejectReason := 'Rejected velocity outside of the axis velocity range';
END_IF

bResetDone := NOT stMotionStage.bError AND NOT stMotionStage.bBusy;

IF bInvalidRequest THEN
    // Hold the stage idle instead of commanding the rejected setpoints
    stMotionStage.bEnable := FALSE;
    stMotionStage.bMoveCmd := FALSE;
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
    bSetDone := FALSE;
    bMotionStarted := FALSE;
    bMoveDone := FALSE;
    // Latch the rejection until the next request or an explicit reset
    IF NOT bError THEN
        bError := TRUE;
        nErrorId := E_LCLSMotionError.INVALID;
        sErrorMessage := sRejectReason;
    END_IF
ELSE
    bMoveDone := stMotionStage.Axis.NcToPlc.ActPos <= fGoalPosition + fDelta AND
                 stMotionStage.Axis.NcToPlc.ActPos >= fGoalPosition - fDelta;

    IF NOT bSetDone THEN
        stMotionStage.bReset := TRUE;
        stMotionStage.bEnable := FALSE;
        IF stMotionStage.stAxisStatus.fActPosition <> fStartPosition THEN
            mcSetPos(
                Axis:=stMotionStage.Axis,
                Execute:=NOT mcSetPos.Execute,
                Position:=fStartPosition,
                Mode:=FALSE,
                Done=>
            );
        ELSE
            bSetDone := TRUE;
        END_IF
    ELSE
        stMotionStage.bEnable := TRUE;
        IF NOT bMotionStarted AND NOT stMotionStage.Axis.Status.Disabled THEN
            stMotionStage.fPosition := fGoalPosition;
            stMotionStage.fVelocity := fVelocity;
            stMotionStage.bMoveCmd := TRUE;
            bMotionStarted := TRUE;
        END_IF
    END_IF

    IF bMoveDone THEN
        stMotionStage.bReset := TRUE;
    END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="Reset" Id="{099bbc37-1b9e-476a-b5a9-5f8f1f38a75e}">
      <Declaration><![CDATA[
METHOD PUBLIC Reset
(*
    Abort the current request and clear every output of this block, including the
    latched setpoint rejection, so that the next bExecute rising edge starts clean.
*)
VAR_IN_OUT
    stMotionStage : ST_MotionStage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
rtExec(CLK:=FALSE);

stMotionStage.bReset := FALSE;
stMotionStage.bEnable := FALSE;
stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
mcSetPos(
    Axis:=stMotionStage.Axis,
    Execute:=FALSE
);
bResetDone := FALSE;
bSetDone := FALSE;
bMotionStarted := FALSE;
bMoveDone := FALSE;
bError := FALSE;
nErrorId := 0;
sErrorMessage := '';
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>