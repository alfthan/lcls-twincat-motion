<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionStageSetAndMoveHelper" Id="{d7e042f5-46bb-44d9-bf49-77a017ae9e25}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionStageSetAndMoveHelper
(*
    Set an ST_MotionStage to a start position, then cause a move towards a goal position.

    On the rising edge of bExecute the axis error is cleared, the user enable is dropped and
    MC_SetPosition brings the axis to fStartPosition. Once fStartPosition is reached the user
    enable is restored and a move towards fGoalPosition is commanded at fVelocity.

    Both waits are bounded: if the axis does not reach fStartPosition within tSetPositionTimeout,
    or does not come within fDelta of fGoalPosition within tMoveTimeout after the move has been
    commanded, this block stops commanding motion and latches bError together with an explicit
    nErrorId and sErrorMessage instead of waiting on a stuck axis forever.

    The motion stage should have its own FB_MotionStage or some stand-in for it running on
    outside of this FB. This is a test helper: see FB_MotionVirtualFrame_Test and
    FB_StatePMPSEnables_Test for usage.

    History:
        2026-11-28 - Added bounded set-position and move timeouts that raise an explicit fault
                     instead of waiting indefinitely (task 445).
*)
VAR_INPUT
    // Begin on rising edge, stop on falling edge.
    bExecute: BOOL;
    // The position to set the motor to
    fStartPosition: LREAL;
    // The goal to move the motor towards
    fGoalPosition: LREAL;
    // The velocity to move at
    fVelocity: LREAL;
    // The allowable deviation from the goal position to be considered done moving.
    fDelta: LREAL;
    // Maximum time to wait for the axis to reset and reach fStartPosition before raising a fault.
    tSetPositionTimeout: TIME := T#10S;
    // Maximum time to wait for the axis to reach fGoalPosition after the move is commanded before raising a fault.
    tMoveTimeout: TIME := T#30S;
END_VAR
VAR_IN_OUT
    stMotionStage: ST_MotionStage;
END_VAR
VAR_OUTPUT
    // Goes to TRUE once the motor has no errors and is deactivated.
    bResetDone: BOOL;
    // Goes to TRUE once the set position completes.
    bSetDone: BOOL;
    // Goes to TRUE once the motor begins moving.
    bMotionStarted: BOOL;
    // Goes to TRUE once the motor reaches its destination.
    bMoveDone: BOOL;
    // Goes to TRUE if the set position or the move timed out. Latched until bExecute rises again or Reset is called.
    bError: BOOL;
    // Error code of the latched fault, see E_LCLSMotionError. Zero when there is no fault.
    nErrorId: UDINT;
    // Human-readable description of the latched fault.
    sErrorMessage: STRING;
END_VAR
VAR
    rtExec: R_TRIG;
    mcSetPos: MC_SetPosition;
    // Bounds the reset and set position phase, from bExecute rising until bSetDone.
    tonSetPosition: TON;
    // Bounds the move phase, from bSetDone until bMoveDone.
    tonMove: TON;
    // TRUE from bExecute rising until the operation completes or a fault is latched.
    bExecActive: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rtExec(CLK:=bExecute);

// A new request starts: drop the enables, clear the outputs and the latched fault, restart the watchdogs
IF rtExec.Q THEN
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
    bResetDone := FALSE;
    bSetDone := FALSE;
    bMotionStarted := FALSE;
    bMoveDone := FALSE;
    bError := FALSE;
    nErrorId := 0;
    sErrorMessage := '';
    bExecActive := TRUE;
    tonSetPosition(
        IN:=FALSE,
        PT:=tSetPositionTimeout
    );
    tonMove(
        IN:=FALSE,
        PT:=tMoveTimeout
    );
END_IF

bResetDone := NOT stMotionStage.bError AND NOT stMotionStage.bBusy;
bMoveDone := stMotionStage.Axis.NcToPlc.ActPos <= fGoalPosition + fDelta AND
             stMotionStage.Axis.NcToPlc.ActPos >= fGoalPosition - fDelta;

// Bound both waits: a stuck axis must raise a fault instead of leaving this block waiting forever
tonSetPosition(
    IN:=bExecActive AND NOT bSetDone AND NOT bError,
    PT:=tSetPositionTimeout
);
tonMove(
    IN:=bExecActive AND bSetDone AND NOT bMoveDone AND NOT bError,
    PT:=tMoveTimeout
);

// Latch the fault on the first timeout and stop commanding motion
IF tonSetPosition.Q THEN
    bError := TRUE;
    nErrorId := E_LCLSMotionError.SET_POSITION_TIMEOUT;
    sErrorMessage := F_MotionErrorCodeLookup(nErrorId:=nErrorId);
    mcSetPos(
        Axis:=stMotionStage.Axis,
        Execute:=FALSE
    );
ELSIF tonMove.Q THEN
    bError := TRUE;
    nErrorId := E_LCLSMotionError.MOVE_TIMEOUT;
    sErrorMessage := F_MotionErrorCodeLookup(nErrorId:=nErrorId);
END_IF

IF (bSetDone AND bMoveDone) OR bError THEN
    bExecActive := FALSE;
END_IF

IF bError THEN
    // Fault latched: hold the axis still until the next request or Reset
    stMotionStage.bEnable := FALSE;
    stMotionStage.bMoveCmd := FALSE;
ELSIF NOT bSetDone THEN
    stMotionStage.bReset := TRUE;
    stMotionStage.bEnable := FALSE;
    IF stMotionStage.stAxisStatus.fActPosition <> fStartPosition THEN
        mcSetPos(
            Axis:=stMotionStage.Axis,
            Execute:=NOT mcSetPos.Execute,
            Position:=fStartPosition,
            Mode:=FALSE,
            Done=>
        );
    ELSE
        bSetDone := TRUE;
    END_IF
ELSE
    stMotionStage.bEnable := TRUE;
    IF NOT bMotionStarted AND NOT stMotionStage.Axis.Status.Disabled THEN
        stMotionStage.fPosition := fGoalPosition;
        stMotionStage.fVelocity := fVelocity;
        stMotionStage.bMoveCmd := TRUE;
        bMotionStarted := TRUE;
    END_IF
END_IF

IF bMoveDone THEN
    stMotionStage.bReset := TRUE;
END_IF
]]></ST>
    </Implementation>
    <Method Name="Reset" Id="{099bbc37-1b9e-476a-b5a9-5f8f1f38a75e}">
      <Declaration><![CDATA[
METHOD PUBLIC Reset
VAR_IN_OUT
    stMotionStage : ST_MotionStage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
rtExec(CLK:=FALSE);

stMotionStage.bReset := FALSE;
stMotionStage.bEnable := FALSE;
stMotionStage.nEnableMode := E_StageEnableMode.NEVER;
mcSetPos(
    Axis:=stMotionStage.Axis,
    Execute:=FALSE
);
bResetDone := FALSE;
bSetDone := FALSE;
bMotionStarted := FALSE;
bMoveDone := FALSE;
// Clear the latched timeout fault and stop the watchdogs
bError := FALSE;
nErrorId := 0;
sErrorMessage := '';
bExecActive := FALSE;
tonSetPosition(
    IN:=FALSE,
    PT:=tSetPositionTimeout
);
tonMove(
    IN:=FALSE,
    PT:=tMoveTimeout
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>