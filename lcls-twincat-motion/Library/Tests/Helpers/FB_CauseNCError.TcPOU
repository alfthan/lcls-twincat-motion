<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_CauseNCError" Id="{d8a15cf9-c36d-4b61-8d5a-347e8910728f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CauseNCError
(*
    Simulate an NC error.
    This will look like a real NC error for everyone, including TwinCAT itself.

    Pulse bExecute to inject nErrorCode into the axis' NC error register.
    The outcome is latched: bDone stays TRUE once the write has completed and
    is only cleared by the caller through bReset. Dropping bExecute (a short
    pulse, or the end of a test step) must not dismiss the result, so code can
    still inspect bDone after the command has been released.
    A new injection does not start until the previous outcome is acknowledged.
*)
VAR_IN_OUT
    // Axis whose NC error register receives the injected error
    Axis: AXIS_REF;
END_VAR
VAR_INPUT
    // Begin the injection on the rising edge, latch the outcome on completion
    bExecute: BOOL;
    // Acknowledge the latched outcome: clears bDone and re-arms the block
    bReset: BOOL;
    // NC error code to write into the drive error register
    nErrorCode: UDINT;
END_VAR
VAR_OUTPUT
    // TRUE while the injection is in progress
    bBusy: BOOL;
    // Latched TRUE once the error code has been written, held until bReset
    bDone: BOOL;
END_VAR
VAR
    // Rising edge detector for bExecute
    rtExec: R_TRIG;
    // Writes nErrorCode into the NC drive error register
    adsWrite: ADSWRITE;
    // Reads the drive address that selects the NC drive error register
    mcReadDriveAddress: MC_ReadDriveAddress;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
rtExec(CLK:=bExecute);

// Without a valid axis reference there is nothing to inject into, and the
// NC accesses below would fault.
IF NOT __ISVALIDREF(Axis) THEN
    RETURN;
END_IF

// The outcome is latched: only the caller's acknowledge clears it.
// The falling edge of bExecute must not dismiss the result.
IF bReset THEN
    bDone := FALSE;
    bBusy := FALSE;
    adsWrite(WRITE:=FALSE);
    mcReadDriveAddress(Execute:=FALSE);
END_IF

// Start a new injection on the rising edge of bExecute, but only once the
// previous outcome has been acknowledged.
IF rtExec.Q AND NOT bDone AND NOT bReset THEN
    bBusy := TRUE;
END_IF

IF bBusy AND NOT mcReadDriveAddress.Done THEN
    mcReadDriveAddress(
        Axis:=Axis,
        Execute:=TRUE,
        DriveAddress=>Axis.DriveAddress);
END_IF

IF bBusy AND mcReadDriveAddress.Done THEN
    bBusy := TRUE;
    adsWrite(
        PORT:=501,
        IDXGRP:=16#4200 + Axis.DriveAddress.NcDriveId,
        IDXOFFS:=16#0019,
        LEN:=SIZEOF(nErrorCode),
        SRCADDR:=ADR(nErrorCode),
        WRITE:=TRUE,
        BUSY=>bBusy);
    IF NOT bBusy THEN
        // Latch the outcome; bReset is the only thing that clears it.
        bDone := TRUE;
        adsWrite(WRITE:=FALSE);
    END_IF
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>